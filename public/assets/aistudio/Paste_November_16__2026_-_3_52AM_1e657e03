<script>
    function switchTab(index) {
        const tabs = document.querySelectorAll('.wa-tab');
        tabs.forEach((t, i) => {
            if(i === index) t.classList.add('active');
            else t.classList.remove('active');
        });
        switchNav(index);
    }

    function switchNav(index) {
        const navItems = document.querySelectorAll('.nav-item');
        const screens = [
            document.getElementById('screen-chats'),
            document.getElementById('screen-updates'),
            document.getElementById('screen-timer'),
            document.getElementById('screen-calls'),
            document.getElementById('screen-profile')
        ];
        
        navItems.forEach((n, i) => {
            if(i === index) n.classList.add('active');
            else n.classList.remove('active');
        });

        screens.forEach((s, i) => {
            if(s) {
                if(i === index) s.classList.add('active');
                else s.classList.remove('active');
            }
        });
    }

    let chatMessages = [
        { id: 1, title: 'Thai Pongal 🍲🌾🐄', type: 'pongal', desc: 'இனிய தை பொங்கல் நல்வாழ்த்துகள்! பொங்கலோ பொங்கல் - உழவர் திருநாள் வாழ்த்துகள்!', isOpened: false }
    ];

    function sendSecureCard(title, type, desc) {
        const newMsg = { id: Date.now(), title, type, desc, isOpened: false };
        chatMessages.push(newMsg);
        document.getElementById('last-snippet').innerText = title;
        document.getElementById('unread-count').innerText = chatMessages.filter(m => !m.isOpened).length;
        alert("✔ " + title + " encrypted & sent securely through VPN-Free global tunnel!");
    }

    function openChatRoom() {
        document.getElementById('screen-chats').classList.remove('active');
        document.getElementById('wa-tabs-container').style.display = 'none';
        document.getElementById('wa-footer-nav').style.display = 'none';
        
        const roomView = document.getElementById('chat-room-view');
        roomView.style.display = 'flex';
        roomView.classList.add('active');
        document.getElementById('app-title').innerText = "Active Chat (Secured)";

        renderMessages();
        document.getElementById('unread-count').innerText = "0";
    }

    function sanitizeInput(str) {
        const temp = document.createElement('div');
        temp.textContent = str;
        return temp.innerHTML;
    }

    function sendSanitizedMessage() {
        const input = document.getElementById('chat-msg-input');
        const rawText = input.value.trim();
        if(!rawText) return;

        if(rawText.toLowerCase().includes('script') || rawText.toLowerCase().includes('malware') || rawText.includes('<iframe')) {
            alert("🛡️ Cyber Shield Alert: Malicious payload neutralized!");
            input.value = '';
            return;
        }

        const safeText = sanitizeInput(rawText);
        chatMessages.push({ id: Date.now(), title: 'Secure Message 🔒', type: 'text', desc: safeText, isOpened: true });
        input.value = '';
        renderMessages();
        alert("✔ Encrypted message sent successfully without VPN!");
    }

    function renderMessages() {
        const container = document.getElementById('messages-container');
        container.innerHTML = '';

        chatMessages.forEach((msg) => {
            const bubble = document.createElement('div');
            bubble.className = 'message-bubble';
            bubble.innerHTML = `
                <h4>${msg.title}</h4>
                <p>${msg.desc}</p>
                <span style="font-size: 9px; color: #008069; display: block; margin-top: 4px;">🛡️ End-to-End Encrypted • ${msg.isOpened ? '✓✓ Viewed' : 'Tap to Open'}</span>
            `;
            
            bubble.onclick = () => {
                if (!msg.isOpened) {
                    msg.isOpened = true;
                    triggerRainAnimation(msg.title, msg.type, msg.desc);
                    renderMessages();
                } else {
                    alert("Secure message already decrypted & viewed.");
                }
            };
            container.appendChild(bubble);
        });
    }

    function backToChats() {
        document.getElementById('chat-room-view').classList.remove('active');
        document.getElementById('chat-room-view').style.display = 'none';
        document.getElementById('screen-chats').classList.add('active');
        document.getElementById('wa-tabs-container').style.display = 'flex';
        document.getElementById('wa-footer-nav').style.display = 'flex';
        closeAnimation();
    }

    function triggerRainAnimation(title, type, desc) {
        const overlay = document.getElementById('animation-overlay');
        document.getElementById('popup-title').innerText = title;
        document.getElementById('popup-desc').innerText = desc;
        overlay.style.display = 'flex';
    }

    function closeAnimation() {
        document.getElementById('animation-overlay').style.display = 'none';
    }

    function toggleAttachmentMenu() {
        const menu = document.getElementById('attachment-menu');
        menu.style.display = menu.style.display === 'flex' ? 'none' : 'flex';
    }

    function sendLocationFromChat(locType) {
        alert("✔ " + locType + " shared securely via encrypted GPS tunnel!");
        document.getElementById('attachment-menu').style.display = 'none';
    }

    function updateUserReligion() {
        const selectedReligion = document.getElementById('user-religion').value;
        alert("✔ Religion preference updated to: " + selectedReligion.toUpperCase() + ". AI Auto-Greetings configured!");
    }

    // SOS Modal Functions
    function openSOSModal() {
        document.getElementById('sos-modal').style.display = 'flex';
    }

    function closeSOSModal() {
        document.getElementById('sos-modal').style.display = 'none';
    }

    function verifyAndSaveEmergencyContacts() {
        const c1 = document.getElementById('ec-1').value.trim();
        const c2 = document.getElementById('ec-2').value.trim();
        const c3 = document.getElementById('ec-3').value.trim();

        if(!c1 || !c2 || !c3) {
            alert("⚠️ தயவுசெய்து 3 அவசரத் தொடர்புகளின் பெயரையும் தொலைபேசி எண்களையும் உள்ளிடவும்!");
            return;
        }

        // Simulated PK Chat User Validation & Permission Request
        alert("🔍 PK Chat Server Verification: Checking if numbers are registered PK Chat users...\n\n✔ All 3 contacts verified as active PK Chat users!\n✔ Permission accepted and linked successfully with Cascade Fail-safe & Offline SMS backup protection.");
    }

    function triggerSOS(emergencyType) {
        closeSOSModal();
        alert("🚨 SOS ALERT ACTIVATED: " + emergencyType + "\n\n📍 5-Hour Live GPS Tracking initiated.\n🔄 Checking status of 3 Emergency Contacts...\n⚠️ Primary contacts offline? Cascade system automatically forwarding alert to secondary backup contacts with offline SMS fallback & Siren!");
    }
</script>
