    }

    function toggleLocationMode() {
        const mode = document.getElementById('call-location-mode').value;
        const statusBanner = document.getElementById('ai-voice-status');
        if(mode === 'local') {
            statusBanner.innerText = "📍 Local District Mode: Direct Native Voice (Translation Bypassed)";
            statusBanner.style.color = "#4caf50";
        } else {
            statusBanner.innerText = "🤖 AI Voice Dubbing: [Auto-detecting foreign language & translating to Tamil voice...]";
            statusBanner.style.color = "#33b3ff";
