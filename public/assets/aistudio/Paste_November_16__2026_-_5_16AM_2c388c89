    }

    function openSexualMedia(id) {
        const msg = chatMessages.find(m => m.id === id);
        if(msg) {
            msg.isOpened = true;
            renderMessages();
            alert("✔ Consent granted. Media decrypted safely.");
        }
    }

    function sendSanitizedMessage() {
        const input = document.getElementById('chat-msg-input');
        const rawText = input.value.trim();
        if(!rawText) return;

        chatMessages.push({ id: Date.now(), title: 'Secure Message 🔒', type: 'text', desc: rawText, isOpened: true });
        input.value = '';
        renderMessages();
        alert("✔ Encrypted message sent successfully!");
    }

