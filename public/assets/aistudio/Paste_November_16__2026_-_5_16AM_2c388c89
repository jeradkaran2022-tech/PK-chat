        document.getElementById('chat-room-view').classList.remove('active');
        document.getElementById('chat-room-view').style.display = 'none';
        document.getElementById('screen-chats').classList.add('active');
        document.getElementById('wa-tabs-container').style.display = 'flex';
        document.getElementById('wa-footer-nav').style.display = 'flex';
