            return;
        }

        alert("🔍 PK Chat Server Verification:\n\n✔ All 3 contacts verified as active PK Chat users!\n✔ Linked successfully with Cascade Fail-safe & Offline SMS backup.");
    }

    function triggerSOS(emergencyType) {
        closeSOSModal();
        alert("🚨 SOS ALERT ACTIVATED: " + emergencyType + "\n\n📍 5-Hour Live GPS Tracking initiated.\n🔄 Checking emergency contacts...");
