class PKSettingsScreen extends StatefulWidget {
  const PKSettingsScreen({Key? key}) : super(key: key);

  @override
  State<PKSettingsScreen> createState() => _PKSettingsScreenState();
}

class _PKSettingsScreenState extends State<PKSettingsScreen> {
  bool _dobSetReminderShown = false;

  void _checkDobReminder() {
    if (!_dobSetReminderShown) {
      setState(() {
        _dobSetReminderShown = true;
      });
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('⚠️ PK Chat நினைவூட்டல்: தயவுசெய்து உங்களுடைய பிறந்த தேதியைச் (DOB) சரிசெய்து கொள்ளுங்கள் (விருப்பத்திற்கேற்ப).'),
          duration: Duration(seconds: 5),
        ),
      );
    }
  }

  @override
  void initState() {
    super.initState();
    WidgetsBinding.instance.addPostFrameCallback((_) => _checkDobReminder());
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text('PK Chat Settings')),
      body: ListView(
        padding: const EdgeInsets.all(15),
        children: [
          _buildSettingItem(Icons.person, 'Account & Privacy', 'Face & Eye verification recovery, Profile DOB Management'),
          _buildSettingItem(Icons.chat, 'Chats', 'Wallpaper, chat history, theme'),
          _buildSettingItem(Icons.notifications, 'Notifications', 'New Notification 051 (High-Gain Active)'),
          _buildSettingItem(Icons.phone_in_talk, 'Call Ring Tone', 'Ringtone 038 (Universfield HD Active)'),
          _buildSettingItem(Icons.help, 'Help', 'FAQ, contact us, privacy policy'),
        ],
      ),
    );
  }

  Widget _buildSettingItem(IconData icon, String title, String subtitle) {
    return ListTile(
      leading: Icon(icon, color: PKChatTheme.deeperBlue),
      title: Text(title, style: const TextStyle(color: Colors.black87)),
      subtitle: Text(subtitle, style: TextStyle(fontSize: 12, color: Colors.grey)),
      trailing: const Icon(Icons.arrow_forward_ios, size: 16, color: Colors.grey),
      onTap: () {},
    );
  }
