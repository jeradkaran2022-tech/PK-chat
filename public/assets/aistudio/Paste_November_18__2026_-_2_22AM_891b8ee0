class PKChatRoomScreen extends StatefulWidget {
  const PKChatRoomScreen({Key? key}) : super(key: key);
  @override
  State<PKChatRoomScreen> createState() => _PKChatRoomScreenState();
}

class _PKChatRoomScreenState extends State<PKChatRoomScreen> {
  bool _isRecording = false;
  bool _hasRecordedAudio = false;
  final TextEditingController _messageController = TextEditingController();

  // Consent-Based Call Recording Prompt (Yes/No)
  void _requestConsentRecording(BuildContext context) {
    showDialog(
      context: context,
      builder: (ctx) => AlertDialog(
        title: const Text('Call Recording Request'),
        content: const Text('The other participant is requesting to record this call. Do you allow this? (Yes / No)'),
        actions: [
          TextButton(
            onPressed: () {
              Navigator.pop(ctx);
              ScaffoldMessenger.of(context).showSnackBar(const SnackBar(content: Text('❌ Recording Denied by Participant.')));
            },
            child: const Text('No', style: TextStyle(color: Colors.red)),
          ),
          ElevatedButton(
            onPressed: () {
              Navigator.pop(ctx);
              ScaffoldMessenger.of(context).showSnackBar(const SnackBar(content: Text('✅ Recording Allowed. Secure Recording Started.')));
            },
            style: ElevatedButton.styleFrom(backgroundColor: PKChatTheme.deeperBlue),
            child: const Text('Yes', style: TextStyle(color: Colors.white)),
          ),
        ],
      ),
    );
  }

  // Voice Preview Dialog before sending
  void _showVoicePreviewDialog() {
    showDialog(
      context: context,
      builder: (ctx) => AlertDialog(
        title: const Text('Voice Note Preview'),
        content: const Text('Listen to your recorded voice note before sending. You can play or discard it.'),
        actions: [
          TextButton(
            onPressed: () {
              Navigator.pop(ctx);
              setState(() { _hasRecordedAudio = false; });
              ScaffoldMessenger.of(context).showSnackBar(const SnackBar(content: Text('🗑️ Voice note discarded.')));
            },
            child: const Text('Discard', style: TextStyle(color: Colors.red)),
          ),
          ElevatedButton(
            onPressed: () {
              Navigator.pop(ctx);
              setState(() { _hasRecordedAudio = false; });
              ScaffoldMessenger.of(context).showSnackBar(const SnackBar(content: Text('📤 Voice note sent successfully!')));
            },
            style: ElevatedButton.styleFrom(backgroundColor: PKChatTheme.primaryBlue),
            child: const Text('Play & Send', style: TextStyle(color: Colors.white)),
          ),
        ],
      ),
    );
  }

  // Delete message / Unsend action
  void _deleteMessageAction() {
    ScaffoldMessenger.of(context).showSnackBar(
      const SnackBar(
        content: Text('🗑️ Message deleted successfully (Delete for Everyone active)!'),
        duration: Duration(seconds: 3),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: Row(children: [
          const CircleAvatar(radius: 18, backgroundColor: Colors.white, child: Text('P', style: TextStyle(color: PKChatTheme.deeperBlue))),
          const SizedBox(width: 10),
          const Text('PK Universal Chat (Video BG & Custom Emojis)', style: TextStyle(fontSize: 10)),
        ]),
        actions: [
          IconButton(
            icon: const Icon(Icons.fiber_smart_record),
            onPressed: () => _requestConsentRecording(context),
            tooltip: 'Request Call Recording',
          ),
        ],
      ),
      body: Stack(
        fit: StackFit.expand,
        children: [
          Positioned.fill(
            child: Opacity(
              opacity: 0.12,
              child: Column(
                mainAxisAlignment: MainAxisAlignment.center,
                children: const [
                  Icon(Icons.flutter_dash, size: 120, color: PKChatTheme.primaryBlue), // Peace Dove
                  SizedBox(height: 10),
                  Icon(Icons.diversity_3, size: 150, color: PKChatTheme.deeperBlue), // Global Unity
                ],
              ),
            ),
          ),
          Column(
            children: [
              Expanded(
                child: ListView(
                  padding: const EdgeInsets.all(15),
                  children: [
                    Center(
                      child: Container(
                        padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 6),
                        decoration: BoxDecoration(color: PKChatTheme.glassWhite, borderRadius: BorderRadius.circular(12), border: Border.all(color: Colors.blue.shade100)),
                        child: Row(
                          mainAxisSize: MainAxisSize.min,
                          children: const [
                            Icon(Icons.phone_missed, color: PKChatTheme.sosRed, size: 16),
                            SizedBox(width: 6),
                            Text('Missed video call • 5:31 pm', style: TextStyle(fontSize: 12, color: Colors.black87)),
                          ],
                        ),
                      ),
                    ),
                    const SizedBox(height: 12),
                    Align(
                      alignment: Alignment.centerLeft,
                      child: Container(
                        padding: const EdgeInsets.all(12),
                        margin: const EdgeInsets.only(bottom: 10),
                        decoration: BoxDecoration(color: PKChatTheme.glassWhite, borderRadius: BorderRadius.circular(15), border: Border.all(color: Colors.cyan.shade200)),
                        child: const Text('Welcome to PK Chat! (Video Call Backgrounds & Custom Emojis Active)', style: TextStyle(color: Colors.black87, fontSize: 14)),
                      ),
                    ),
                    // 3D One-Time Animation Emoji / Greeting Example (Santa Claus / Festival)
                    Align(
                      alignment: Alignment.centerRight,
                      child: GestureDetector(
                        onLongPress: _deleteMessageAction,
                        child: Container(
                          padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
                          margin: const EdgeInsets.only(bottom: 10),
                          decoration: BoxDecoration(
                            color: PKChatTheme.primaryBlue,
                            borderRadius: BorderRadius.circular(15),
                          ),
                          child: Column(
                            crossAxisAlignment: CrossAxisAlignment.end,
                            children: [
                              Row(
                                mainAxisSize: MainAxisSize.min,
                                children: const [
                                  Icon(Icons.celebration, color: Colors.yellow, size: 20),
                                  SizedBox(width: 6),
                                  Text('🌟 PK Chat 3D Animated Festival Greeting!', style: TextStyle(color: Colors.white, fontSize: 11, fontWeight: FontWeight.bold)),
                                ],
                              ),
                              const SizedBox(height: 4),
                              const Text('5:32 PM ✓✓ (Long press to Unsend)', style: TextStyle(fontSize: 9, color: Colors.white70)),
                            ],
                          ),
                        ),
                      ),
                    ),
                  ],
                ),
              ),
              Container(
                padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 8),
                color: Colors.white,
                child: Row(
                  children: [
                    Expanded(
                      child: Container(
                        decoration: BoxDecoration(color: Colors.blue.shade50.withOpacity(0.5), borderRadius: BorderRadius.circular(30)),
                        child: Row(
                          children: [
                            const SizedBox(width: 12),
                            const Icon(Icons.emoji_emotions_outlined, color: Colors.grey),
                            const SizedBox(width: 8),
                            Expanded(
                              child: TextField(
                                controller: _messageController,
                                decoration: const InputDecoration(hintText: 'Message (PK Custom Emojis Active)', border: InputBorder.none),
                              ),
                            ),
                            const Icon(Icons.attach_file, color: Colors.grey),
                            const SizedBox(width: 12),
                            const Icon(Icons.camera_alt, color: Colors.grey),
                            const SizedBox(width: 12),
                          ],
                        ),
                      ),
                    ),
                    const SizedBox(width: 6),
                    // Dynamic Blue Voice Recorder Button with Lock & Preview Support
                    Container(
                      decoration: BoxDecoration(
                        color: _isRecording ? Colors.redAccent : PKChatTheme.primaryBlue,
                        shape: BoxShape.circle,
                        boxShadow: [BoxShadow(color: PKChatTheme.primaryBlue.withOpacity(0.5), blurRadius: 6, spreadRadius: 2)],
                      ),
                      child: IconButton(
                        icon: Icon(_isRecording ? Icons.stop : Icons.mic, color: Colors.white),
                        onPressed: () { 
                          HapticFeedback.lightImpact();
                          setState(() { 
                            _isRecording = !_isRecording;
                            if (!_isRecording) {
                              _hasRecordedAudio = true;
                            }
                          });
                          if (_hasRecordedAudio) {
                            _showVoicePreviewDialog();
                          }
                        },
                      ),
                    ),
                  ],
                ),
              ),
            ],
          ),
        ],
      ),
    );
  }
