import React, { useState, useCallback } from 'react';

export default function PKChatApp() {
  const [step, setStep] = useState('profile');
  
  // User Profile States
  const [userName, setUserName] = useState('');
  const [userEmail, setUserEmail] = useState('');
  const [userPhone, setUserPhone] = useState('');
  const [selectedLanguage, setSelectedLanguage] = useState('Tamil (Sri Lanka)');
  
  // Main App States
  const [activeTab, setActiveTab] = useState('chats');
  const [dialNumber, setDialNumber] = useState('');
  const [savedContacts, setSavedContacts] = useState([
    { id: 1, name: 'Jerad Karan', number: '717860693' }
  ]);
  
  const [statusPrivacy, setStatusPrivacy] = useState('favorites');
  const [statusText, setStatusText] = useState('');
  const [statuses, setStatuses] = useState([
    { id: 1, user: 'Jerad Karan', text: 'Online & Safe 2027 🚀', privacy: 'favorites' }
  ]);
  
  const [chatMessage, setChatMessage] = useState('');
  const [fontStyle, setFontStyle] = useState('normal');
  const [messages, setMessages] = useState([
    { sender: 'Jerad Karan', text: 'Happy New Year 2027! 🎆🥂', type: 'text' },
    { sender: 'Jerad Karan', text: 'இனிய தை பொங்கல் நல்வாழ்த்துகள்! 🌾🍚', type: 'text' },
    { sender: 'Jerad Karan', text: 'Merry Christmas & Happy Easter! 🎄🐰', type: 'text' }
  ]);

  // Global Festival & Keyword Animation State
  const [chatAnimation, setChatAnimation] = useState(null);
  
  const [isRecording, setIsRecording] = useState(false);
  const [sosActive, setSosActive] = useState(false);
  const [callActive, setCallActive] = useState(false);
  const [callType, setCallType] = useState('');
  const [beautyFilterActive, setBeautyFilterActive] = useState(false);
  const [cameraFacing, setCameraFacing] = useState('front');

  // Comprehensive Keyword & Global Festival Animation Trigger
  const triggerAnimationEffect = (text) => {
    const lower = text.toLowerCase();
    if (lower.includes('pongal') || lower.includes('பொங்கல்') || lower.includes('தை')) {
      setChatAnimation('pongal');
    } else if (lower.includes('new year') || lower.includes('2027') || lower.includes('புத்தாண்டு')) {
      setChatAnimation('newyear');
    } else if (lower.includes('christmas') || lower.includes('கிறிஸ்மஸ்') || lower.includes('xmas')) {
      setChatAnimation('christmas');
    } else if (lower.includes('easter') || lower.includes('ஈஸ்டர்')) {
      setChatAnimation('easter');
    } else if (lower.includes('diwali') || lower.includes('தீபாவளி') || lower.includes('deepavali')) {
      setChatAnimation('diwali');
    } else if (lower.includes('eid') || lower.includes('ரம்ஜான்') || lower.includes('ramzan')) {
      setChatAnimation('eid');
    } else if (lower.includes('morning') || lower.includes('குட் மார்னிங்')) {
      setChatAnimation('sun');
    } else if (lower.includes('love') || lower.includes('ஐ லவ் யூ') || lower.includes('❤️') || lower.includes('அன்பு')) {
      setChatAnimation('hearts');
    } else if (lower.includes('miss') || lower.includes('மிஸ் யூ')) {
      setChatAnimation('miss');
    } else if (lower.includes('birthday') || lower.includes('பிறந்தநாள்')) {
      setChatAnimation('birthday');
    } else if (lower.includes('cold') || lower.includes('குளிர்') || lower.includes('பனி')) {
      setChatAnimation('snow');
    }
    setTimeout(() => setChatAnimation(null), 4500);
  };

  // Step 1: Profile
  const handleProfileSubmit = (e) => {
    e.preventDefault();
    if (!userName || !userPhone) {
      alert('தயவுசெய்து உங்கள் பெயர் மற்றும் தொலைபேசி எண்ணை உள்ளிடவும்!');
      return;
    }
    setStep('language');
  };

  // Step 2: Language
  const handleStartApp = () => {
    setStep('main');
  };

  // Save Contact Feature
  const handleSaveContact = () => {
    if (!dialNumber) {
      alert('சேமிக்க எண்களை டயல் பேடில் உள்ளிடவும்!');
      return;
    }
    const name = prompt('இந்த எண்ணிற்கான பெயரை உள்ளிடவும் (Enter Contact Name):', 'My Contact');
    if (!name) return;

    setSavedContacts(prev => [...prev, { id: Date.now(), name, number: dialNumber }]);
    alert(`தொலைபேசி எண் "${dialNumber}" (${name}) வெற்றிகரமாகச் சேமிக்கப்பட்டது!`);
    setDialNumber('');
  };

  // Stylish Font Helper
  const applyStylishFont = (text, style) => {
    if (!text) return '';
    if (style === 'bold') {
      return text.split('').map(char => {
        const code = char.charCodeAt(0);
        if (code >= 65 && code <= 90) return String.fromCodePoint(code + 120276);
        if (code >= 97 && code <= 122) return String.fromCodePoint(code + 120270);
        return char;
      }).join('');
    } else if (style === 'fancy') {
      return text.split('').map(char => {
        const code = char.charCodeAt(0);
        if (code >= 65 && code <= 90) return String.fromCodePoint(code + 120328);
        if (code >= 97 && code <= 122) return String.fromCodePoint(code + 120322);
        return char;
      }).join('');
    } else if (style === 'caps') {
      return text.toUpperCase() + ' ✨';
    }
    return text;
  };

  // Status Upload & Gallery Download
  const handleAddStatus = useCallback((e) => {
    e.preventDefault();
    if (!statusText.trim()) return;
    setStatuses(prev => [...prev, { id: Date.now(), user: 'You', text: statusText, privacy: statusPrivacy }]);
    setStatusText('');
    alert('ஸ்டேட்டஸ் வெற்றிகரமாகப் பதிவிடப்பட்டது! (Cloud Storage Protected)');
  }, [statusText, statusPrivacy]);

  const handleDownloadToGallery = (statusTextItem) => {
    alert(`"${statusTextItem}" உங்கள் மொபைல் கேலரியில் வெற்றிகரமாகச் சேமிக்கப்பட்டது!`);
  };

  const handleSendMessage = useCallback((e) => {
    e.preventDefault();
    if (!chatMessage.trim()) return;
    const finalFormattedText = applyStylishFont(chatMessage, fontStyle);
    
    setMessages(prev => [...prev, { sender: 'You', text: finalFormattedText, type: 'text' }]);
    triggerAnimationEffect(chatMessage);
    setChatMessage('');
  }, [chatMessage, fontStyle]);

  const handleRecordVoiceNote = () => {
    if (!isRecording) {
      setIsRecording(true);
      alert('🎙️ Voice Recording Started... Speak in your language. Tap again to send.');
    } else {
      setIsRecording(false);
      setMessages(prev => [
        ...prev, 
        { sender: 'You', text: '🎤 Voice Note sent (Auto-Translated Audio)', type: 'voice' }
      ]);
      alert('✅ Voice Note successfully translated and delivered globally!');
    }
  };

  const playTranslatedAudio = (msgText) => {
    alert(`🔊 Playing Translated Voice Audio in ${selectedLanguage}: "${msgText}"`);
  };

  const startVideoCall = () => {
    if (!dialNumber) { alert('முதலில் தொலைபேசி எண்ணை டயல் செய்யவும்!'); return; }
    setCallType('Video Call (HD Face Clarity)');
    setCallActive(true);
    setBeautyFilterActive(true);
    setCameraFacing('front');
  };

  const startAudioCall = () => {
    if (!dialNumber) { alert('முதலில் தொலைபேசி எண்ணை டயல் செய்யவும்!'); return; }
    setCallType('Audio Call');
    setCallActive(true);
    setBeautyFilterActive(false);
  };

  const toggleCamera = () => {
    setCameraFacing(prev => (prev === 'front' ? 'back' : 'front'));
  };

  // 1. PROFILE SETUP SCREEN
  if (step === 'profile') {
    return (
      <div style={styles.authContainer}>
        <div style={styles.authBox}>
          <h2 style={{color: '#00a884'}}>PK CHAT 2027 - Profile Setup</h2>
          <p style={{fontSize: '12px', color: '#aaa'}}>30-day free trial ($10/yr after)</p>
          <form onSubmit={handleProfileSubmit} style={styles.authForm}>
            <input type="text" placeholder="Full Name (e.g. Prasanth)" value={userName} onChange={(e) => setUserName(e.target.value)} style={styles.authInput} />
            <input type="email" placeholder="Email Address" value={userEmail} onChange={(e) => setUserEmail(e.target.value)} style={styles.authInput} />
            <input type="tel" placeholder="Phone Number (e.g. 717860693)" value={userPhone} onChange={(e) => setUserPhone(e.target.value)} style={styles.authInput} />
            <button type="submit" style={styles.authBtn}>Next: Choose Language -&gt;</button>
          </form>
        </div>
      </div>
    );
  }

  // 2. LANGUAGE SELECTION SCREEN (Clean & Fixed Layout)
  if (step === 'language') {
    return (
      <div style={styles.authContainer}>
        <div style={styles.authBox}>
          <h2 style={{color: '#00a884'}}>Choose Language</h2>
          <p style={{fontSize: '12px', color: '#aaa'}}>Selected: {selectedLanguage}</p>
          <div style={styles.langScrollBox}>
            {['Tamil (Sri Lanka)', 'Tamil', 'English (Global)', 'Sinhala', 'Arabic', 'Hindi'].map((lang) => (
              <button 
                key={lang} 
                onClick={() => setSelectedLanguage(lang)} 
                style={{
                  padding: '10px', 
                  backgroundColor: selectedLanguage === lang ? '#00a884' : '#2a3942', 
                  color: '#fff', 
                  border: 'none', 
                  borderRadius: '5px', 
                  cursor: 'pointer', 
                  fontWeight: 'bold',
                  textAlign: 'left'
                }}
              >
                🌐 {lang}
              </button>
            ))}
          </div>
          <button onClick={handleStartApp} style={styles.authBtn}>Start PK CHAT</button>
        </div>
      </div>
    );
  }

  // 3. MAIN APP SCREEN
  return (
    <div style={styles.container}>
      <header style={styles.header}>
        <div style={styles.logoRow}>
          <h2 style={styles.logo}>PK CHAT 2027</h2>
          <span style={styles.trialBadge}>✨ Global Edition ($10/yr)</span>
        </div>
        <nav style={styles.navTabs}>
          {['chats', 'status', 'calls', 'alerts', 'festivals'].map((tab) => (
            <button key={tab} onClick={() => setActiveTab(tab)} style={{...styles.tabButton, backgroundColor: activeTab === tab ? '#00a884' : 'transparent', color: activeTab === tab ? '#fff' : '#ddd'}}>
              {tab === 'festivals' ? '🎉 FESTIVALS' : tab.toUpperCase()}
            </button>
          ))}
        </nav>
      </header>

      <main style={styles.content}>
        
        {/* CHATS TAB */}
        {activeTab === 'chats' && (
          <div style={styles.viewSection}>
            <h3>Chats & Global Festival Animations</h3>
            
            {chatAnimation === 'pongal' && (
              <div style={styles.festivalOverlay}>
                <div style={styles.animationIcon}>🌾 🍚 🍯 🌅</div>
                <span style={{color: '#ffcc00', fontWeight: 'bold', fontSize: '15px'}}>இனிய தை பொங்கல் நல்வாழ்த்துகள்! Happy Pongal!</span>
              </div>
            )}
            {chatAnimation === 'newyear' && (
              <div style={styles.festivalOverlay}>
                <div style={styles.animationIcon}>🎆 🥂 🌟 🎊</div>
                <span style={{color: '#00ffcc', fontWeight: 'bold', fontSize: '15px'}}>Happy New Year 2027! இனிய புத்தாண்டு வாழ்த்துகள்!</span>
              </div>
            )}
            {chatAnimation === 'christmas' && (
              <div style={styles.festivalOverlay}>
                <div style={styles.animationIcon}>🎄 🎅 🎁 ❄️</div>
                <span style={{color: '#ff3366', fontWeight: 'bold', fontSize: '15px'}}>Merry Christmas! இனிய கிறிஸ்துமஸ் வாழ்த்துகள்!</span>
              </div>
            )}
            {chatAnimation === 'easter' && (
              <div style={styles.festivalOverlay}>
                <div style={styles.animationIcon}>🐰 🐣 🌷 ✨</div>
                <span style={{color: '#ff99ff', fontWeight: 'bold', fontSize: '15px'}}>Happy Easter! இனிய ஈஸ்டர் திருநாள் வாழ்த்துகள்!</span>
              </div>
            )}
            {chatAnimation === 'diwali' && (
              <div style={styles.festivalOverlay}>
                <div style={styles.animationIcon}>🪔 ✨ 🎆 🎇</div>
                <span style={{color: '#ff9900', fontWeight: 'bold', fontSize: '15px'}}>Happy Diwali! இனிய தீபாவளி நல்வாழ்த்துகள்!</span>
              </div>
            )}
            {chatAnimation === 'eid' && (
              <div style={styles.festivalOverlay}>
                <div style={styles.animationIcon}>🌙 ⭐ 🕌 🕊️</div>
                <span style={{color: '#00ff99', fontWeight: 'bold', fontSize: '15px'}}>Eid Mubarak! இனிய ரம்ஜான் திருநாள் வாழ்த்துகள்!</span>
              </div>
            )}
            {chatAnimation === 'sun' && (
              <div style={styles.festivalOverlay}>
                <div style={styles.animationIcon}>☀️ 🌅</div>
                <span style={{color: '#ffcc00', fontWeight: 'bold', fontSize: '14px'}}>Good Morning! Sun Rising...</span>
              </div>
            )}
            {chatAnimation === 'hearts' && (
              <div style={styles.festivalOverlay}>
                <div style={styles.animationIcon}>💖💕 💗 💓 ✨</div>
                <span style={{color: '#ff3366', fontWeight: 'bold', fontSize: '14px'}}>I Love You! Endless Hearts...</span>
              </div>
            )}
            {chatAnimation === 'miss' && (
              <div style={styles.festivalOverlay}>
                <div style={styles.animationIcon}>💭 🥺 ✨ 💫</div>
                <span style={{color: '#00ffcc', fontWeight: 'bold', fontSize: '14px'}}>Miss You! Thinking of you...</span>
              </div>
            )}
            {chatAnimation === 'birthday' && (
              <div style={styles.festivalOverlay}>
                <div style={styles.animationIcon}>🎂 🎈 🎉 🎁</div>
                <span style={{color: '#ff9900', fontWeight: 'bold', fontSize: '14px'}}>Happy Birthday! Celebration...</span>
              </div>
            )}
            {chatAnimation === 'snow' && (
              <div style={styles.festivalOverlay}>
                <div style={styles.animationIcon}>❄️ 🌨️ 🧊 ❄️</div>
                <span style={{color: '#00ffff', fontWeight: 'bold', fontSize: '14px'}}>Cold Weather! Snow Falling...</span>
              </div>
            )}

            <div style={styles.styleSelectorRow}>
              <span style={{fontSize: '12px', color: '#00ffcc'}}>Font Style:</span>
              {['normal', 'bold', 'fancy', 'caps'].map((s) => (
                <button key={s} onClick={() => setFontStyle(s)} style={{...styles.styleChip, backgroundColor: fontStyle === s ? '#00a884' : '#2a3942'}}>
                  {s.toUpperCase()}
                </button>
              ))}
            </div>

            <div style={styles.chatBox}>
              {messages.map((msg, index) => (
                <div key={index} style={styles.chatBubble}>
                  <strong>{msg.sender}:</strong> {msg.text}
                  {msg.type === 'voice' && (
                    <button onClick={() => playTranslatedAudio(msg.text)} style={styles.playAudioBtn}>
                      ▶️ Play Translated Voice Note ({selectedLanguage})
                    </button>
                  )}
                  <div style={styles.translationText}>🔄 Global Voice & Text Translated</div>
                </div>
              ))}
            </div>

            <div style={styles.inputForm}>
              <input type="text" value={chatMessage} onChange={(e) => setChatMessage(e.target.value)} placeholder="Type 'Pongal', '2027', 'Christmas', 'Love'..." style={styles.inputField} />
              <button onClick={handleSendMessage} style={styles.actionBtn}>Send</button>
              <button onClick={handleRecordVoiceNote} style={{...styles.micBtn, backgroundColor: isRecording ? '#ff3b30' : '#007bff'}} title="Voice Note">
                {isRecording ? '🔴' : '🎙️'}
              </button>
            </div>
          </div>
        )}

        {/* STATUS TAB */}
        {activeTab === 'status' && (
          <div style={styles.viewSection}>
            <h3>Status Updates & Privacy</h3>
            <div style={styles.privacyBox}>
              <label>Privacy: </label>
              <select value={statusPrivacy} onChange={(e) => setStatusPrivacy(e.target.value)} style={styles.selectField}>
                <option value="everyone">Everyone (அனைவரும்)</option>
                <option value="contacts">My Contacts (நண்பர்கள்)</option>
                <option value="favorites">Favorites Only (பிடித்த நபர்கள் - VIP)</option>
              </select>
            </div>
            <form onSubmit={handleAddStatus} style={styles.inputForm}>
              <input type="text" value={statusText} onChange={(e) => setStatusText(e.target.value)} placeholder="Share status..." style={styles.inputField} />
              <button type="submit" style={styles.actionBtn}>Post</button>
            </form>
            <div style={styles.statusList}>
              <h4>Recent Statuses:</h4>
              {statuses.map((s) => (
                <div key={s.id} style={styles.statusItem}>
                  <div>
                    <span>👤 {s.user}: {s.text}</span>
                    <small style={{color: '#00ffcc', display: 'block'}}> [Privacy: {s.privacy}]</small>
                  </div>
                  <button onClick={() => handleDownloadToGallery(s.text)} style={styles.downloadBtn}>
                    📥 Save to Gallery
                  </button>
                </div>
              ))}
            </div>
          </div>
        )}

        {/* CALLS TAB */}
        {activeTab === 'calls' && (
          <div style={styles.viewSection}>
            <h3>📞 In-App Dial Pad, Save Contact & HD Calls</h3>
            {!callActive ? (
              <div style={styles.dialerScreen}>
                <input type="text" value={dialNumber} placeholder="Enter or dial number..." readOnly style={styles.dialInput} />
                
                <div style={styles.keypadGrid}>
                  {['1', '2', '3', '4', '5', '6', '7', '8', '9', '*', '0', '#'].map((digit) => (
                    <button key={digit} onClick={() => setDialNumber(prev => prev + digit)} style={styles.digitBtn}>
                      {digit}
                    </button>
                  ))}
                </div>

                <div style={styles.callActionRow}>
                  <button style={styles.saveContactBtn} onClick={handleSaveContact}>💾 Save Contact</button>
                  <button style={styles.clearBtn} onClick={() => setDialNumber('')}>Clear</button>
                </div>

                <div style={{marginTop: '15px', display: 'flex', justifyContent: 'center', gap: '10px'}}>
                  <button style={styles.audioCallBtn} onClick={startAudioCall}>📞 Audio Call</button>
                  <button style={styles.videoCallBtn} onClick={startVideoCall}>📹 HD Video Call</button>
                </div>

                <div style={{marginTop: '20px', textAlign: 'left', backgroundColor: '#111b21', padding: '10px', borderRadius: '5px'}}>
                  <h4 style={{margin: '0 0 10px 0', color: '#00ffcc'}}>Saved Contacts:</h4>
                  {savedContacts.map(c => (
                    <div key={c.id} style={{display: 'flex', justifyContent: 'space-between', padding: '5px 0', borderBottom: '1px solid #2a3942'}}>
                      <span>👤 {c.name}</span>
                      <span style={{color: '#aaa'}}>{c.number}</span>
                    </div>
                  ))}
                </div>
              </div>
            ) : (
              <div style={styles.activeCallScreen}>
                <h2>Ongoing {callType}</h2>
                <p>Connected to: <strong>{dialNumber}</strong></p>
                <div style={{...styles.videoPreviewBox, filter: beautyFilterActive && cameraFacing === 'front' ? 'brightness(1.15) contrast(1.05) saturate(1.1)' : 'none'}}>
                  <div style={styles.avatarPlaceholder}>
                    {cameraFacing === 'front' ? '🤳 (Front Camera)' : '📸 (Back Camera)'}
                  </div>
                  <div style={styles.cameraBadge}>Active: {cameraFacing.toUpperCase()} CAMERA</div>
                  {beautyFilterActive && cameraFacing === 'front' && (
                    <div style={styles.beautyBadge}>✨ HD Face Clarity Active</div>
                  )}
                </div>
                <div style={styles.callControlRow}>
                  {callType.includes('Video') && (
                    <button style={styles.switchCameraBtn} onClick={toggleCamera}>🔄 Switch Camera</button>
                  )}
                  <button style={styles.endCallBtn} onClick={() => { setCallActive(false); setBeautyFilterActive(false); }}>🔴 End Call</button>
                </div>
              </div>
            )}
          </div>
        )}

        {/* EMERGENCY SOS TAB */}
        {activeTab === 'alerts' && (
          <div style={styles.viewSection}>
            <h3>Emergency SOS & Disaster Alerts</h3>
            <p>5-Hour live GPS tracking, siren override, and regional disaster alerts.</p>
            <button style={{...styles.sosBtn, backgroundColor: sosActive ? '#ff3b30' : '#28a745'}} onClick={() => { setSosActive(!sosActive); alert(sosActive ? 'SOS Deactivated' : '🚨 SOS Activated!'); }}>
              {sosActive ? '🚨 SOS ACTIVE (Tap to Deactivate)' : '🚨 Trigger Emergency SOS'}
            </button>
          </div>
        )}

        {/* FESTIVALS TAB */}
        {activeTab === 'festivals' && (
          <div style={styles.viewSection}>
            <h3>🌍 2027 Global Festival & 3D Greeting Cards</h3>
            <p style={{fontSize: '12px', color: '#00ffcc'}}>Tap any card to send instant multi-cultural festival greetings!</p>
            <div style={styles.card3dGrid}>
              <div style={styles.card3dItem} onClick={() => setMessages(prev => [...prev, { sender: 'You', text: '🎆🥂 Happy New Year 2027! புத்தாண்டு வாழ்த்துகள்!', type: 'text' }])}>
                <div style={{fontSize: '28px'}}>🎆🥂</div>
                <div style={{fontWeight: 'bold', fontSize: '13px', marginTop: '5px'}}>New Year 2027</div>
              </div>
              <div style={styles.card3dItem} onClick={() => setMessages(prev => [...prev, { sender: 'You', text: '🌾🍚 இனிய தை பொங்கல் நல்வாழ்த்துகள்! Happy Pongal!', type: 'text' }])}>
                <div style={{fontSize: '28px'}}>🌾🍚</div>
                <div style={{fontWeight: 'bold', fontSize: '13px', marginTop: '5px'}}>Thai Pongal</div>
              </div>
              <div style={styles.card3dItem} onClick={() => setMessages(prev => [...prev, { sender: 'You', text: '🎄🎅 Merry Christmas! கிறிஸ்துமஸ் வாழ்த்துகள்!', type: 'text' }])}>
                <div style={{fontSize: '28px'}}>🎄🎅</div>
                <div style={{fontWeight: 'bold', fontSize: '13px', marginTop: '5px'}}>Christmas</div>
              </div>
              <div style={styles.card3dItem} onClick={() => setMessages(prev => [...prev, { sender: 'You', text: '🐰🌷 Happy Easter! ஈஸ்டர் வாழ்த்துகள்!', type: 'text' }])}>
