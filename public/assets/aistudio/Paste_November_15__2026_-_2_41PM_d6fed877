              </div>
              <div style={styles.card3dItem} onClick={() => setMessages(prev => [...prev, { sender: 'You', text: '🌙⭐ Eid Mubarak! ரம்ஜான் வாழ்த்துகள்!', type: 'text' }])}>
                <div style={{fontSize: '28px'}}>🌙⭐</div>
                <div style={{fontWeight: 'bold', fontSize: '13px', marginTop: '5px'}}>Eid / Ramzan</div>
              </div>
            </div>
          </div>
        )}

      </main>
    </div>
  );
}

