rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Helpers
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        request.auth.token.phone_number != null ||
        request.auth.token.firebase.sign_in_provider in ['apple.com', 'google.com', 'password', 'anonymous']
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isOwnerEmail() {
      return 'email' in request.auth.token
        && request.auth.token.email is string
        && request.auth.token.email.lower() in ['jeradkaran2022@gmail.com', 'jeradprasanth27@gmail.com']
        && request.auth.token.email_verified == true;
    }

    function isOwnerAdmin() {
      return isSignedIn() && (
        isOwnerEmail() ||
        (exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == 'owner')
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        isOwnerEmail() ||
        (exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role in ['owner', 'security_admin', 'support_admin'])
      );
    }

    function isSystemLockedDown() {
      return exists(/databases/$(database)/documents/system_security/global)
        && get(/databases/$(database)/documents/system_security/global).data.status == 'LOCKDOWN';
    }

    function isNotBlockedInProfileMedia(targetUid) {
      return !exists(/databases/$(database)/documents/profile_media/$(targetUid)) ||
        !(request.auth.uid in get(/databases/$(database)/documents/profile_media/$(targetUid)).data.blockedUserIds);
    }

    function canViewUserProfile(profileData) {
      return (!('blockedUserIds' in profileData) || !(request.auth.uid in profileData.blockedUserIds))
        && (!('profileVisibility' in profileData) || profileData.profileVisibility != 'nobody');
    }

    function isParentChatMember(chatType, chatId) {
      return (
        chatType == 'direct' &&
        exists(/databases/$(database)/documents/chats/$(chatId)) &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds
      ) || (
        chatType == 'group' &&
        exists(/databases/$(database)/documents/group_chats/$(chatId)) &&
        request.auth.uid in get(/databases/$(database)/documents/group_chats/$(chatId)).data.memberIds
      );
    }

    function matchesChatParticipants(chatType, chatId, participantIds) {
      return isParentChatMember(chatType, chatId) && (
        (chatType == 'direct' &&
          participantIds.size() == get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds.size() &&
          participantIds.hasAll(get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds) &&
          get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds.hasAll(participantIds)) ||
        (chatType == 'group' &&
          participantIds.size() == get(/databases/$(database)/documents/group_chats/$(chatId)).data.memberIds.size() &&
          participantIds.hasAll(get(/databases/$(database)/documents/group_chats/$(chatId)).data.memberIds) &&
          get(/databases/$(database)/documents/group_chats/$(chatId)).data.memberIds.hasAll(participantIds))
      );
    }

    // Entity Validators
    function isValidUserAccount(data) {
      return data.keys().hasAll(['uid', 'country', 'countryDialCode', 'accountStatus', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'phoneNumber', 'email', 'country', 'countryDialCode', 'recoveryEmail', 'phoneDiscoveryEnabled', 'accountStatus', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.country is string && data.country.size() >= 1 && data.country.size() <= 80
        && data.countryDialCode is string && data.countryDialCode.size() >= 1 && data.countryDialCode.size() <= 10
        && data.accountStatus in ['active', 'suspended', 'deleted']
        && (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 32))
        && (!('email' in data) || (data.email is string && data.email.size() <= 254))
        && (!('recoveryEmail' in data) || (data.recoveryEmail is string && data.recoveryEmail.size() <= 254))
        && (!('phoneDiscoveryEnabled' in data) || data.phoneDiscoveryEnabled is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'fullName', 'country', 'countryCode', 'preferredLanguage', 'preferredLanguageName', 'onlineStatus', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'fullName', 'about', 'bio', 'statusMessage', 'avatarUrl', 'coverImageUrl', 'country', 'countryCode', 'preferredLanguage', 'preferredLanguageName', 'profileVisibility', 'profilePhotoVisibility', 'aboutVisibility', 'blockedUserIds', 'e2eePublicKey', 'onlineStatus', 'onlineSince', 'lastSeen', 'lastSeenVisibility', 'onlineVisibility', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 100
        && (!('about' in data) || (data.about is string && data.about.size() <= 140))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 300))
        && (!('statusMessage' in data) || (data.statusMessage is string && data.statusMessage.size() <= 100))
        && data.country is string && data.country.size() >= 1 && data.country.size() <= 80
        && data.countryCode is string && data.countryCode.size() >= 2 && data.countryCode.size() <= 8
        && data.preferredLanguage is string && data.preferredLanguage.size() >= 2 && data.preferredLanguage.size() <= 16
        && data.preferredLanguageName is string && data.preferredLanguageName.size() >= 2 && data.preferredLanguageName.size() <= 64
        && (!('profileVisibility' in data) || data.profileVisibility in ['everyone', 'contacts', 'nobody'])
        && (!('profilePhotoVisibility' in data) || data.profilePhotoVisibility in ['everyone', 'contacts', 'nobody'])
        && (!('aboutVisibility' in data) || data.aboutVisibility in ['everyone', 'contacts', 'nobody'])
        && (!('blockedUserIds' in data) || (data.blockedUserIds is list && data.blockedUserIds.size() <= 100 && (data.blockedUserIds.size() == 0 || data.blockedUserIds[0] is string)))
        && data.onlineStatus in ['online', 'away', 'offline']
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 200000))
        && (!('coverImageUrl' in data) || (data.coverImageUrl is string && data.coverImageUrl.size() <= 300000))
        && (!('e2eePublicKey' in data) || (data.e2eePublicKey is string && data.e2eePublicKey.size() <= 1024))
        && (!('onlineSince' in data) || data.onlineSince is timestamp)
        && (!('lastSeen' in data) || data.lastSeen is timestamp)
        && (!('lastSeenVisibility' in data) || data.lastSeenVisibility in ['everyone', 'contacts', 'nobody'])
        && (!('onlineVisibility' in data) || data.onlineVisibility in ['everyone', 'same_as_last_seen'])
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProfileMedia(data) {
      return data.keys().hasAll(['userId', 'avatarDataUrl', 'coverDataUrl', 'avatarMimeType', 'coverMimeType', 'about', 'bio', 'statusMessage', 'profileVisibility', 'profilePhotoVisibility', 'aboutVisibility', 'blockedUserIds', 'syncVersion', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'avatarDataUrl', 'coverDataUrl', 'avatarMimeType', 'coverMimeType', 'about', 'bio', 'statusMessage', 'profileVisibility', 'profilePhotoVisibility', 'aboutVisibility', 'blockedUserIds', 'syncVersion', 'updatedAt'])
        && isValidId(data.userId)
        && data.avatarDataUrl is string && data.avatarDataUrl.size() <= 200000
        && (data.avatarDataUrl == '' || data.avatarDataUrl.matches('^data:image/(jpeg|jpg|png|webp);base64,[A-Za-z0-9+/=]+$') || data.avatarDataUrl.matches('^/[a-zA-Z0-9_./-]+$') || data.avatarDataUrl.matches('^https://.*'))
        && data.coverDataUrl is string && data.coverDataUrl.size() <= 300000
        && (data.coverDataUrl == '' || data.coverDataUrl.matches('^data:image/(jpeg|jpg|png|webp);base64,[A-Za-z0-9+/=]+$') || data.coverDataUrl.matches('^https://.*'))
        && data.avatarMimeType is string && data.avatarMimeType.size() <= 32
        && data.coverMimeType is string && data.coverMimeType.size() <= 32
        && data.about is string && data.about.size() <= 140
        && data.bio is string && data.bio.size() <= 300
        && data.statusMessage is string && data.statusMessage.size() <= 100
        && data.profileVisibility in ['everyone', 'contacts', 'nobody']
        && data.profilePhotoVisibility in ['everyone', 'contacts', 'nobody']
        && data.aboutVisibility in ['everyone', 'contacts', 'nobody']
        && data.blockedUserIds is list && data.blockedUserIds.size() <= 100 && (data.blockedUserIds.size() == 0 || data.blockedUserIds[0] is string)
        && data.syncVersion is int && data.syncVersion >= 1
        && data.updatedAt is timestamp;
    }

    function isValidUserDevice(data) {
      return data.keys().hasAll(['deviceId', 'userId', 'deviceName', 'platform', 'trusted', 'createdAt'])
        && data.keys().hasOnly(['deviceId', 'userId', 'deviceName', 'platform', 'trusted', 'otpVerifiedAt', 'lastActiveAt', 'createdAt'])
        && isValidId(data.deviceId)
        && isValidId(data.userId)
        && data.deviceName is string && data.deviceName.size() >= 1 && data.deviceName.size() <= 120
        && data.platform is string && data.platform.size() >= 1 && data.platform.size() <= 40
        && data.trusted is bool
        && (!('otpVerifiedAt' in data) || data.otpVerifiedAt is timestamp)
        && (!('lastActiveAt' in data) || data.lastActiveAt is timestamp)
        && data.createdAt is timestamp;
    }

    function isValidLanguagePreference(data) {
      return data.keys().hasAll(['userId', 'primaryLanguage', 'primaryLanguageName', 'autoDetect', 'preserveOriginal', 'defaultViewMode', 'voiceTranslationEnabled', 'ttsVoice', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'primaryLanguage', 'primaryLanguageName', 'autoDetect', 'preserveOriginal', 'defaultViewMode', 'voiceTranslationEnabled', 'ttsVoice', 'updatedAt'])
        && isValidId(data.userId)
        && data.primaryLanguage is string && data.primaryLanguage.size() >= 2 && data.primaryLanguage.size() <= 16
        && data.primaryLanguageName is string && data.primaryLanguageName.size() >= 2 && data.primaryLanguageName.size() <= 64
        && data.autoDetect is bool
        && data.preserveOriginal is bool
        && data.defaultViewMode in ['translated', 'original', 'bilingual']
        && data.voiceTranslationEnabled is bool
        && data.ttsVoice in ['Kore', 'Puck', 'Charon', 'Fenrir', 'Zephyr']
        && data.updatedAt is timestamp;
    }

    function isValidContact(data) {
      return data.keys().hasAll(['ownerId', 'contactUid', 'displayName', 'country', 'preferredLanguage', 'blocked', 'reported', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'contactUid', 'displayName', 'phoneMasked', 'country', 'preferredLanguage', 'preferredLanguageName', 'blocked', 'reported', 'reportReason', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && isValidId(data.contactUid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.country is string && data.country.size() >= 1 && data.country.size() <= 80
        && data.preferredLanguage is string && data.preferredLanguage.size() >= 2 && data.preferredLanguage.size() <= 16
        && (!('preferredLanguageName' in data) || (data.preferredLanguageName is string && data.preferredLanguageName.size() <= 64))
        && (!('phoneMasked' in data) || (data.phoneMasked is string && data.phoneMasked.size() <= 32))
        && (!('reportReason' in data) || (data.reportReason is string && data.reportReason.size() <= 300))
        && data.blocked is bool
        && data.reported is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDirectChat(data) {
      return data.keys().hasAll(['chatId', 'participantIds', 'createdBy', 'e2eeEnabled', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['chatId', 'participantIds', 'createdBy', 'title', 'lastMessage', 'lastSenderId', 'typingUserId', 'wallpaperId', 'e2eeEnabled', 'createdAt', 'updatedAt'])
        && isValidId(data.chatId)
        && isValidId(data.createdBy)
        && data.participantIds is list && data.participantIds.size() == 2
        && data.participantIds[0] is string && data.participantIds[1] is string
        && data.e2eeEnabled is bool
        && (!('title' in data) || (data.title is string && data.title.size() <= 120))
        && (!('lastMessage' in data) || (data.lastMessage is string && data.lastMessage.size() <= 500))
        && (!('lastSenderId' in data) || (data.lastSenderId is string && data.lastSenderId.size() <= 128))
        && (!('typingUserId' in data) || (data.typingUserId is string && data.typingUserId.size() <= 128))
        && (!('wallpaperId' in data) || (data.wallpaperId is string && data.wallpaperId.size() <= 128))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidGroupChat(data) {
      return data.keys().hasAll(['groupId', 'name', 'createdBy', 'memberIds', 'adminIds', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['groupId', 'name', 'description', 'createdBy', 'memberIds', 'adminIds', 'lastMessage', 'lastSenderId', 'wallpaperId', 'createdAt', 'updatedAt'])
        && isValidId(data.groupId)
        && isValidId(data.createdBy)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.memberIds is list && data.memberIds.size() >= 1 && data.memberIds.size() <= 50 && data.memberIds[0] is string
        && data.adminIds is list && data.adminIds.size() >= 1 && data.adminIds.size() <= 20 && data.adminIds[0] is string
        && (!('description' in data) || (data.description is string && data.description.size() <= 300))
        && (!('lastMessage' in data) || (data.lastMessage is string && data.lastMessage.size() <= 500))
        && (!('lastSenderId' in data) || (data.lastSenderId is string && data.lastSenderId.size() <= 128))
        && (!('wallpaperId' in data) || (data.wallpaperId is string && data.wallpaperId.size() <= 128))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['messageId', 'chatId', 'chatType', 'participantIds', 'senderId', 'senderName', 'senderLanguage', 'messageType', 'originalText', 'e2eeEnabled', 'deleted', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['messageId', 'chatId', 'chatType', 'participantIds', 'senderId', 'senderName', 'senderLanguage', 'messageType', 'originalText', 'encryptedPayload', 'e2eeEnabled', 'mediaName', 'mediaMimeType', 'mediaPreviewData', 'replyToId', 'replyToText', 'forwardedFrom', 'burnAfterSeconds', 'expiresAtMs', 'deleted', 'deliveredTo', 'readBy', 'createdAt', 'updatedAt'])
        && isValidId(data.messageId)
        && isValidId(data.chatId)
        && data.chatType in ['direct', 'group']
        && data.participantIds is list && data.participantIds.size() >= 1 && data.participantIds.size() <= 50 && data.participantIds[0] is string
        && isValidId(data.senderId)
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 100
        && data.senderLanguage is string && data.senderLanguage.size() >= 2 && data.senderLanguage.size() <= 16
        && data.messageType in ['text', 'image', 'video', 'document', 'voice', 'sticker']
        && data.originalText is string && data.originalText.size() <= 10000
        && data.e2eeEnabled is bool
        && data.deleted is bool
        && (!('encryptedPayload' in data) || (data.encryptedPayload is string && data.encryptedPayload.size() <= 16000))
        && (!('mediaName' in data) || (data.mediaName is string && data.mediaName.size() <= 255))
        && (!('mediaMimeType' in data) || (data.mediaMimeType is string && data.mediaMimeType.size() <= 100))
        && (!('mediaPreviewData' in data) || (data.mediaPreviewData is string && data.mediaPreviewData.size() <= 350000))
        && (!('replyToId' in data) || (data.replyToId is string && data.replyToId.size() <= 128))
        && (!('replyToText' in data) || (data.replyToText is string && data.replyToText.size() <= 300))
        && (!('forwardedFrom' in data) || (data.forwardedFrom is string && data.forwardedFrom.size() <= 100))
        && (!('burnAfterSeconds' in data) || (data.burnAfterSeconds is int && data.burnAfterSeconds >= 5 && data.burnAfterSeconds <= 604800))
        && (!('expiresAtMs' in data) || (data.expiresAtMs is int && data.expiresAtMs > 0))
        && (!('deliveredTo' in data) || (data.deliveredTo is list && data.deliveredTo.size() <= 50))
        && (!('readBy' in data) || (data.readBy is list && data.readBy.size() <= 50))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTranslatedMessage(data) {
      return data.keys().hasAll(['messageId', 'chatId', 'targetUserId', 'participantIds', 'sourceLanguage', 'targetLanguage', 'translatedText', 'engine', 'createdAt'])
        && data.keys().hasOnly(['messageId', 'chatId', 'targetUserId', 'participantIds', 'sourceLanguage', 'targetLanguage', 'translatedText', 'engine', 'createdAt'])
        && isValidId(data.messageId)
        && isValidId(data.chatId)
        && isValidId(data.targetUserId)
        && data.participantIds is list && data.participantIds.size() >= 1 && data.participantIds.size() <= 50 && data.participantIds[0] is string
        && data.sourceLanguage is string && data.sourceLanguage.size() >= 2 && data.sourceLanguage.size() <= 16
        && data.targetLanguage is string && data.targetLanguage.size() >= 2 && data.targetLanguage.size() <= 16
        && data.translatedText is string && data.translatedText.size() <= 12000
        && data.engine is string && data.engine.size() >= 1 && data.engine.size() <= 64
        && data.createdAt is timestamp;
    }

    function isValidCallRecord(data) {
      return data.keys().hasAll(['callId', 'callerId', 'callerName', 'participantIds', 'callType', 'status', 'sourceLanguage', 'targetLanguage', 'durationSeconds', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['callId', 'callerId', 'callerName', 'participantIds', 'callType', 'status', 'sourceLanguage', 'targetLanguage', 'durationSeconds', 'offerSdp', 'answerSdp', 'createdAt', 'updatedAt'])
        && isValidId(data.callId)
        && isValidId(data.callerId)
        && data.callerName is string && data.callerName.size() >= 1 && data.callerName.size() <= 100
        && data.participantIds is list && data.participantIds.size() >= 1 && data.participantIds.size() <= 20 && data.participantIds[0] is string
        && data.callType in ['audio', 'video']
        && data.status in ['ringing', 'active', 'ended', 'missed']
        && data.sourceLanguage is string && data.sourceLanguage.size() >= 2 && data.sourceLanguage.size() <= 16
        && data.targetLanguage is string && data.targetLanguage.size() >= 2 && data.targetLanguage.size() <= 16
        && data.durationSeconds is int && data.durationSeconds >= 0 && data.durationSeconds <= 86400
        && (!('offerSdp' in data) || (data.offerSdp is string && data.offerSdp.size() <= 32000))
        && (!('answerSdp' in data) || (data.answerSdp is string && data.answerSdp.size() <= 32000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCallSignal(data) {
      return data.keys().hasAll(['callerId', 'receiverId', 'callType', 'status', 'expiresAt', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['callId', 'callerId', 'receiverId', 'callerName', 'receiverName', 'callType', 'status', 'expiresAt', 'createdAt', 'updatedAt', 'endedAt'])
        && (!('callId' in data) || isValidId(data.callId))
        && isValidId(data.callerId)
        && isValidId(data.receiverId)
        && data.callerId != data.receiverId
        && (!('callerName' in data) || (data.callerName is string && data.callerName.size() >= 1 && data.callerName.size() <= 100))
        && (!('receiverName' in data) || (data.receiverName is string && data.receiverName.size() >= 1 && data.receiverName.size() <= 100))
        && data.callType in ['audio', 'video']
        && data.status in ['ringing', 'accepted', 'rejected', 'ended']
        && data.expiresAt is string && data.expiresAt.size() >= 10 && data.expiresAt.size() <= 40
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('endedAt' in data) || data.endedAt == null || data.endedAt is timestamp);
    }

    function isValidUserSettings(data) {
      return data.keys().hasAll(['userId', 'theme', 'bubbleColor', 'wallpaperId', 'pinLockEnabled', 'biometricEnabled', 'readReceipts', 'lastSeenVisible', 'notificationsEnabled', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'theme', 'bubbleColor', 'wallpaperId', 'customWallpaperData', 'pinLockEnabled', 'appLockPinHash', 'biometricEnabled', 'readReceipts', 'lastSeenVisible', 'lastSeenVisibility', 'onlineVisibility', 'notificationsEnabled', 'voiceSecurityAlertsEnabled', 'appLanguage', 'appLanguageName', 'autoFestivalGreetEnabled', 'updatedAt'])
        && isValidId(data.userId)
        && data.theme in ['light', 'dark', 'system']
        && data.bubbleColor is string && data.bubbleColor.size() >= 2 && data.bubbleColor.size() <= 32
        && data.wallpaperId is string && data.wallpaperId.size() >= 1 && data.wallpaperId.size() <= 128
        && (!('customWallpaperData' in data) || (data.customWallpaperData is string && data.customWallpaperData.size() <= 350000))
        && (!('appLockPinHash' in data) || (data.appLockPinHash is string && data.appLockPinHash.size() <= 128))
        && (!('lastSeenVisibility' in data) || data.lastSeenVisibility in ['everyone', 'contacts', 'nobody'])
        && (!('onlineVisibility' in data) || data.onlineVisibility in ['everyone', 'same_as_last_seen'])
        && (!('voiceSecurityAlertsEnabled' in data) || data.voiceSecurityAlertsEnabled is bool)
        && (!('appLanguage' in data) || (data.appLanguage is string && data.appLanguage.size() >= 2 && data.appLanguage.size() <= 16))
        && (!('appLanguageName' in data) || (data.appLanguageName is string && data.appLanguageName.size() >= 1 && data.appLanguageName.size() <= 64))
        && (!('autoFestivalGreetEnabled' in data) || data.autoFestivalGreetEnabled is bool)
        && data.pinLockEnabled is bool
        && data.biometricEnabled is bool
        && data.readReceipts is bool
        && data.lastSeenVisible is bool
        && data.notificationsEnabled is bool
        && data.updatedAt is timestamp;
    }

    function isValidWallpaper(data) {
      return data.keys().hasAll(['wallpaperId', 'title', 'category', 'imageUrl', 'isBuiltIn', 'ownerId', 'createdAt'])
        && data.keys().hasOnly(['wallpaperId', 'title', 'category', 'imageUrl', 'isBuiltIn', 'ownerId', 'createdAt'])
        && isValidId(data.wallpaperId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 80
        && data.category in ['nature', 'flowers', 'ocean', 'mountains', 'abstract', 'romantic', 'custom']
        && data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 350000
        && data.isBuiltIn is bool
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128
        && data.createdAt is timestamp;
    }

    function isValidSubscription(data) {
      return data.keys().hasAll(['userId', 'plan', 'status', 'monthlyPriceUsd', 'autoRenew', 'paymentMode', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'plan', 'status', 'monthlyPriceUsd', 'autoRenew', 'paymentMode', 'trialStartAt', 'trialEndAt', 'currentPeriodEnd', 'updatedAt'])
        && isValidId(data.userId)
        && data.plan in ['trial', 'pro_monthly', 'free']
        && data.status in ['trialing', 'active', 'cancelled', 'expired']
        && data.monthlyPriceUsd is number && data.monthlyPriceUsd >= 0 && data.monthlyPriceUsd <= 100
        && data.autoRenew is bool
        && data.paymentMode == 'test'
        && (!('trialStartAt' in data) || data.trialStartAt is timestamp)
        && (!('trialEndAt' in data) || data.trialEndAt is timestamp)
        && (!('currentPeriodEnd' in data) || data.currentPeriodEnd is timestamp)
        && data.updatedAt is timestamp;
    }

    function isValidPaymentRecord(data) {
      return data.keys().hasAll(['paymentId', 'userId', 'amountUsd', 'currency', 'status', 'provider', 'description', 'createdAt'])
        && data.keys().hasOnly(['paymentId', 'userId', 'amountUsd', 'currency', 'status', 'provider', 'description', 'createdAt'])
        && isValidId(data.paymentId)
        && isValidId(data.userId)
        && data.amountUsd is number && data.amountUsd >= 0 && data.amountUsd <= 500
        && data.currency is string && data.currency.size() == 3
        && data.status in ['succeeded_test', 'refunded_test', 'failed_test']
        && data.provider in ['test_mode_gateway', 'google_play_test', 'apple_iap_test']
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 200
        && data.createdAt is timestamp;
    }

