        && data.description is string && data.description.size() >= 6 && data.description.size() <= 600
        && data.mediaType in ['image', 'video']
        && data.mediaUrl is string && data.mediaUrl.size() >= 1 && data.mediaUrl.size() <= 450000
        && (!('mediaMimeType' in data) || (data.mediaMimeType is string && data.mediaMimeType.size() <= 64))
        && data.targetCountry is string && data.targetCountry.size() >= 2 && data.targetCountry.size() <= 80
        && data.targetLanguage is string && data.targetLanguage.size() >= 2 && data.targetLanguage.size() <= 48
        && data.adScale in ['small', 'large']
        && data.pricePaidUsd is number && data.pricePaidUsd >= 0 && data.pricePaidUsd <= 1000
        && data.playBillingSku is string && data.playBillingSku.size() >= 3 && data.playBillingSku.size() <= 64
        && data.selfieVerified == true
        && (!('enableDirectCall' in data) || data.enableDirectCall is bool)
        && (!('enableLiveClass' in data) || data.enableLiveClass is bool)
        && data.status in ['active', 'under_review', 'suspended']
        && data.reportCount is int && data.reportCount >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdFulfillmentRequest(data) {
      return data.keys().hasAll(['requestId', 'adId', 'sellerUid', 'buyerUid', 'buyerName', 'fulfillmentType', 'feeUsd', 'status', 'createdAt'])
        && data.keys().hasOnly(['requestId', 'adId', 'sellerUid', 'buyerUid', 'buyerName', 'fulfillmentType', 'deliveryNote', 'scheduledDateTime', 'feeUsd', 'status', 'createdAt'])
        && isValidId(data.requestId)
        && isValidId(data.adId)
        && isValidId(data.sellerUid)
        && isValidId(data.buyerUid)
        && data.buyerUid != data.sellerUid
        && data.buyerName is string && data.buyerName.size() >= 1 && data.buyerName.size() <= 100
        && data.fulfillmentType in ['deliver_to_location', 'direct_pickup', 'scheduled_delivery']
        && (!('deliveryNote' in data) || (data.deliveryNote is string && data.deliveryNote.size() <= 280))
        && (!('scheduledDateTime' in data) || (data.scheduledDateTime is string && data.scheduledDateTime.size() <= 64))
        && data.feeUsd == 0
        && data.status in ['requested', 'confirmed', 'received']
        && data.createdAt is timestamp;
    }

    function isValidAdReport(data) {
      return data.keys().hasAll(['reportId', 'adId', 'reporterUid', 'category', 'createdAt'])
        && data.keys().hasOnly(['reportId', 'adId', 'reporterUid', 'category', 'reason', 'createdAt'])
        && isValidId(data.reportId)
        && isValidId(data.adId)
        && isValidId(data.reporterUid)
        && data.category in ['spam_misleading', 'prohibited_scam', 'explicit_adult', 'harassment_hate', 'counterfeit_ip', 'fake_business']
        && (!('reason' in data) || (data.reason is string && data.reason.size() <= 300))
        && data.createdAt is timestamp;
    }

    function isValidViolationWarning(data) {
      return data.keys().hasAll(['warningId', 'adId', 'sellerUid', 'violationCategory', 'evidenceSummary', 'reporterCount', 'policyClause', 'actionTaken', 'issuedAt', 'read'])
        && data.keys().hasOnly(['warningId', 'adId', 'sellerUid', 'violationCategory', 'evidenceSummary', 'reporterCount', 'policyClause', 'actionTaken', 'issuedAt', 'read'])
        && isValidId(data.warningId)
        && isValidId(data.adId)
        && isValidId(data.sellerUid)
        && data.violationCategory in ['spam_misleading', 'prohibited_scam', 'explicit_adult', 'harassment_hate', 'counterfeit_ip', 'fake_business']
        && data.evidenceSummary is string && data.evidenceSummary.size() >= 1 && data.evidenceSummary.size() <= 400
        && data.reporterCount is int && data.reporterCount >= 0
        && data.policyClause is string && data.policyClause.size() >= 1 && data.policyClause.size() <= 160
        && data.actionTaken in ['suspended', 'formal_warning']
        && data.issuedAt is timestamp
        && data.read is bool;
    }

    function isValidRemoteAdConfig(data) {
      return data.keys().hasAll(['billingLibraryVersion', 'smallAdPriceUsd', 'largeAdPriceUsd', 'annualProPriceUsd', 'freeTrialDays', 'updatedAt'])
        && data.keys().hasOnly(['billingLibraryVersion', 'smallAdPriceUsd', 'largeAdPriceUsd', 'annualProPriceUsd', 'freeTrialDays', 'updatedAt'])
        && data.billingLibraryVersion is string && data.billingLibraryVersion.size() >= 1 && data.billingLibraryVersion.size() <= 24
        && data.smallAdPriceUsd is number && data.smallAdPriceUsd >= 1 && data.smallAdPriceUsd <= 500
        && data.largeAdPriceUsd is number && data.largeAdPriceUsd >= 1 && data.largeAdPriceUsd <= 1000
        && data.annualProPriceUsd is number && data.annualProPriceUsd >= 1 && data.annualProPriceUsd <= 500
        && data.freeTrialDays is int && data.freeTrialDays >= 7 && data.freeTrialDays <= 365
        && data.updatedAt is timestamp;
    }

    // 1. users (Private PII)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedUser() && isValidId(userId) && isOwner(userId)
        && isValidUserAccount(incoming())
        && (!isSystemLockedDown() || isAdmin())
        && incoming().uid == userId
        && incoming().uid == request.auth.uid
        && incoming().accountStatus == 'active'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(userId)
        && isValidUserAccount(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (!isSystemLockedDown() || isAdmin())
        && (
          isAdmin() ||
          (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['phoneNumber', 'email', 'country', 'countryDialCode', 'recoveryEmail', 'phoneDiscoveryEnabled', 'updatedAt']))
        );
      allow delete: if isAdmin() && !isSystemLockedDown();
    }

    // 2. user_profiles (Public-safe directory without PII; enforces block list and nobody visibility)
    match /user_profiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (
        isOwner(userId) ||
        isAdmin() ||
        canViewUserProfile(existing())
      );
      allow list: if isSignedIn() && (
        isAdmin() ||
        resource.data.uid == request.auth.uid ||
        (request.query.limit != null && request.query.limit <= 50)
      );
      allow create: if isVerifiedUser() && isValidId(userId) && isOwner(userId)
        && isValidUserProfile(incoming())
        && (!isSystemLockedDown() || isAdmin())
        && incoming().uid == userId
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (!isSystemLockedDown() || isAdmin())
        && (
          isAdmin() ||
          (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'about', 'bio', 'statusMessage', 'avatarUrl', 'coverImageUrl', 'country', 'countryCode', 'preferredLanguage', 'preferredLanguageName', 'profileVisibility', 'profilePhotoVisibility', 'aboutVisibility', 'blockedUserIds', 'e2eePublicKey', 'onlineStatus', 'onlineSince', 'lastSeen', 'lastSeenVisibility', 'onlineVisibility', 'updatedAt']))
        );
      allow delete: if isAdmin() && !isSystemLockedDown();
    }

    // 3. user_devices
    match /user_devices/{deviceId} {
      allow get: if isSignedIn() && isValidId(deviceId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() && isValidId(deviceId)
        && isValidUserDevice(incoming())
        && incoming().deviceId == deviceId
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isVerifiedUser() && isValidId(deviceId)
        && isValidUserDevice(incoming())
        && incoming().userId == existing().userId
        && incoming().deviceId == existing().deviceId
        && incoming().createdAt == existing().createdAt
        && (
          isAdmin() ||
          (existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['trusted', 'otpVerifiedAt', 'lastActiveAt', 'deviceName']))
        );
      allow delete: if isSignedIn() && isValidId(deviceId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // 4. language_preferences
    match /language_preferences/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedUser() && isValidId(userId) && isOwner(userId)
        && isValidLanguagePreference(incoming())
        && incoming().userId == request.auth.uid
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(userId)
        && isValidLanguagePreference(incoming())
        && incoming().userId == existing().userId
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['primaryLanguage', 'primaryLanguageName', 'autoDetect', 'preserveOriginal', 'defaultViewMode', 'voiceTranslationEnabled', 'ttsVoice', 'updatedAt']))
        );
      allow delete: if isAdmin();
    }

    // 5. contacts
    match /contacts/{contactId} {
      allow get: if isSignedIn() && isValidId(contactId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() && isValidId(contactId)
        && isValidContact(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(contactId)
        && isValidContact(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().contactUid == existing().contactUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (existing().ownerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phoneMasked', 'country', 'preferredLanguage', 'preferredLanguageName', 'blocked', 'reported', 'reportReason', 'updatedAt']))
        );
      allow delete: if isSignedIn() && isValidId(contactId) && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // 6. chats (Direct 1-to-1)
    match /chats/{chatId} {
      allow get: if isSignedIn() && isValidId(chatId) && (request.auth.uid in existing().participantIds || isAdmin());
      allow list: if isSignedIn() && (request.auth.uid in resource.data.participantIds || isAdmin());
      allow create: if isVerifiedUser() && isValidId(chatId)
        && isValidDirectChat(incoming())
        && (!isSystemLockedDown() || isAdmin())
        && incoming().chatId == chatId
        && incoming().createdBy == request.auth.uid
        && request.auth.uid in incoming().participantIds
        && isNotBlockedInProfileMedia(incoming().participantIds[0])
        && isNotBlockedInProfileMedia(incoming().participantIds[1])
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(chatId)
        && isValidDirectChat(incoming())
        && (!isSystemLockedDown() || isAdmin())
        && incoming().chatId == existing().chatId
        && incoming().createdBy == existing().createdBy
        && incoming().participantIds == existing().participantIds
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            request.auth.uid in existing().participantIds &&
            incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'lastSenderId', 'typingUserId', 'wallpaperId', 'e2eeEnabled', 'updatedAt']) &&
            (!('lastSenderId' in incoming()) || incoming().lastSenderId == request.auth.uid || ('lastSenderId' in existing() && incoming().lastSenderId == existing().lastSenderId)) &&
            (!('typingUserId' in incoming()) || incoming().typingUserId == '' || incoming().typingUserId == request.auth.uid || ('typingUserId' in existing() && incoming().typingUserId == existing().typingUserId))
          )
        );
      allow delete: if isAdmin() && !isSystemLockedDown();
    }

    // 7. group_chats
    match /group_chats/{groupId} {
      allow get: if isSignedIn() && isValidId(groupId) && (request.auth.uid in existing().memberIds || isAdmin());
      allow list: if isSignedIn() && (request.auth.uid in resource.data.memberIds || isAdmin());
      allow create: if isVerifiedUser() && isValidId(groupId)
        && isValidGroupChat(incoming())
        && (!isSystemLockedDown() || isAdmin())
        && incoming().groupId == groupId
        && incoming().createdBy == request.auth.uid
        && request.auth.uid in incoming().memberIds
        && request.auth.uid in incoming().adminIds
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(groupId)
        && isValidGroupChat(incoming())
        && incoming().groupId == existing().groupId
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (!isSystemLockedDown() || isAdmin())
        && (
          isAdmin() ||
          (request.auth.uid in existing().adminIds && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'memberIds', 'adminIds', 'lastMessage', 'lastSenderId', 'wallpaperId', 'updatedAt'])) ||
          (
            request.auth.uid in existing().memberIds &&
            incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'lastSenderId', 'updatedAt']) &&
            (!('lastSenderId' in incoming()) || incoming().lastSenderId == request.auth.uid || ('lastSenderId' in existing() && incoming().lastSenderId == existing().lastSenderId))
          )
        );
      allow delete: if isAdmin() && !isSystemLockedDown();
    }

    // 8. messages (Master Gate: strictly requires parent chat/group membership)
    match /messages/{messageId} {
      allow get: if isSignedIn() && isValidId(messageId) && (
        isAdmin() ||
        (request.auth.uid in existing().participantIds && isParentChatMember(existing().chatType, existing().chatId))
      );
      allow list: if isSignedIn() && (request.auth.uid in resource.data.participantIds || isAdmin());
      allow create: if isVerifiedUser() && isValidId(messageId)
        && isValidMessage(incoming())
        && (!isSystemLockedDown() || isAdmin())
        && incoming().messageId == messageId
        && incoming().senderId == request.auth.uid
        && request.auth.uid in incoming().participantIds
        && matchesChatParticipants(incoming().chatType, incoming().chatId, incoming().participantIds)
        && incoming().deleted == false
        && (!('deliveredTo' in incoming()) || incoming().deliveredTo == [request.auth.uid])
        && (!('readBy' in incoming()) || incoming().readBy == [request.auth.uid])
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(messageId)
        && isValidMessage(incoming())
        && (!isSystemLockedDown() || isAdmin())
        && incoming().messageId == existing().messageId
        && incoming().chatId == existing().chatId
        && incoming().chatType == existing().chatType
        && incoming().senderId == existing().senderId
        && incoming().participantIds == existing().participantIds
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().senderId == request.auth.uid &&
            existing().deleted == false &&
            incoming().deleted == true &&
            incoming().diff(existing()).affectedKeys().hasOnly(['deleted', 'originalText', 'encryptedPayload', 'mediaPreviewData', 'mediaName', 'updatedAt'])
          ) ||
          (
            request.auth.uid in existing().participantIds &&
            isParentChatMember(existing().chatType, existing().chatId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['deliveredTo', 'readBy', 'updatedAt']) &&
            request.auth.uid in incoming().deliveredTo &&
            request.auth.uid in incoming().readBy &&
            (!('deliveredTo' in existing()) || incoming().deliveredTo.hasAll(existing().deliveredTo)) &&
            (!('readBy' in existing()) || incoming().readBy.hasAll(existing().readBy))
          )
        );
      allow delete: if isAdmin() && !isSystemLockedDown();
    }

    // 9. translated_messages (Linked strictly to existing parent message participants)
    match /translated_messages/{translationId} {
      allow get: if isSignedIn() && isValidId(translationId) && (request.auth.uid in existing().participantIds || existing().targetUserId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (request.auth.uid in resource.data.participantIds || resource.data.targetUserId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() && isValidId(translationId)
        && isValidTranslatedMessage(incoming())
        && (!isSystemLockedDown() || isAdmin())
        && request.auth.uid in incoming().participantIds
        && exists(/databases/$(database)/documents/messages/$(incoming().messageId))
        && request.auth.uid in get(/databases/$(database)/documents/messages/$(incoming().messageId)).data.participantIds
        && incoming().participantIds == get(/databases/$(database)/documents/messages/$(incoming().messageId)).data.participantIds
        && incoming().chatId == get(/databases/$(database)/documents/messages/$(incoming().messageId)).data.chatId
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() && !isSystemLockedDown();
    }

    // 10. call_records
    match /call_records/{callId} {
      allow get: if isSignedIn() && isValidId(callId) && (request.auth.uid in existing().participantIds || isAdmin());
      allow list: if isSignedIn() && (request.auth.uid in resource.data.participantIds || isAdmin());
      allow create: if isVerifiedUser() && isValidId(callId)
        && isValidCallRecord(incoming())
        && (!isSystemLockedDown() || isAdmin())
        && incoming().callId == callId
        && incoming().callerId == request.auth.uid
        && request.auth.uid in incoming().participantIds
        && incoming().status == 'ringing'
        && incoming().durationSeconds == 0
        && !('answerSdp' in incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(callId)
        && isValidCallRecord(incoming())
        && (!isSystemLockedDown() || isAdmin())
        && incoming().callId == existing().callId
        && incoming().callerId == existing().callerId
        && incoming().callerName == existing().callerName
        && incoming().participantIds == existing().participantIds
        && incoming().callType == existing().callType
        && incoming().sourceLanguage == existing().sourceLanguage
        && incoming().targetLanguage == existing().targetLanguage
        && (!('offerSdp' in existing()) ? !('offerSdp' in incoming()) : incoming().offerSdp == existing().offerSdp)
        && incoming().durationSeconds >= existing().durationSeconds
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && !(existing().status in ['ended', 'missed'])
        && (
          isAdmin() ||
          (request.auth.uid in existing().participantIds && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'durationSeconds', 'answerSdp', 'updatedAt']))
        );
      allow delete: if isAdmin();
    }

    // 11. user_settings
    match /user_settings/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedUser() && isValidId(userId) && isOwner(userId)
        && isValidUserSettings(incoming())
        && incoming().userId == request.auth.uid
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(userId)
        && isValidUserSettings(incoming())
        && (!isSystemLockedDown() || isAdmin())
        && incoming().userId == existing().userId
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['theme', 'bubbleColor', 'wallpaperId', 'customWallpaperData', 'pinLockEnabled', 'appLockPinHash', 'biometricEnabled', 'readReceipts', 'lastSeenVisible', 'lastSeenVisibility', 'onlineVisibility', 'notificationsEnabled', 'voiceSecurityAlertsEnabled', 'appLanguage', 'appLanguageName', 'autoFestivalGreetEnabled', 'updatedAt']))
        );
      allow delete: if isAdmin() && !isSystemLockedDown();
    }

    // 12. wallpapers
    match /wallpapers/{wallpaperId} {
      allow get: if isSignedIn() && isValidId(wallpaperId) && (existing().isBuiltIn == true || existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.isBuiltIn == true || resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() && isValidId(wallpaperId)
        && isValidWallpaper(incoming())
        && (
          isAdmin() ||
          (incoming().isBuiltIn == false && incoming().ownerId == request.auth.uid)
        )
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isSignedIn() && isValidId(wallpaperId) && ((existing().isBuiltIn == false && existing().ownerId == request.auth.uid) || isAdmin());
    }

    // 13. subscriptions
    match /subscriptions/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedUser() && isValidId(userId) && isOwner(userId)
        && isValidSubscription(incoming())
        && incoming().userId == request.auth.uid
        && incoming().paymentMode == 'test'
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(userId)
        && isValidSubscription(incoming())
        && incoming().userId == existing().userId
        && incoming().paymentMode == 'test'
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['plan', 'status', 'autoRenew', 'currentPeriodEnd', 'updatedAt']))
        );
      allow delete: if isAdmin();
    }

    // 14. payment_records
    match /payment_records/{paymentId} {
      allow get: if isSignedIn() && isValidId(paymentId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() && isValidId(paymentId)
        && isValidPaymentRecord(incoming())
        && (!isSystemLockedDown() || isAdmin())
        && incoming().paymentId == paymentId
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isAdmin() && isValidId(paymentId) && isValidPaymentRecord(incoming());
      allow delete: if isAdmin();
    }

    // 15. emergency_contacts
    match /emergency_contacts/{contactId} {
      allow get: if isSignedIn() && isValidId(contactId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() && isValidId(contactId)
        && isValidEmergencyContact(incoming())
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isVerifiedUser() && isValidId(contactId)
        && isValidEmergencyContact(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && (
          isAdmin() ||
          (existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'relationship', 'countryCode', 'notifyOnSos']))
        );
      allow delete: if isSignedIn() && isValidId(contactId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // 16. sos_alerts
    match /sos_alerts/{alertId} {
      allow get: if isSignedIn() && isValidId(alertId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() && isValidId(alertId)
        && isValidSosAlert(incoming())
        && incoming().alertId == alertId
        && incoming().userId == request.auth.uid
        && incoming().status == 'active'
        && incoming().alertOrigin == 'user_generated'
        && incoming().emergencyServicesNotified == false
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(alertId)
        && isValidSosAlert(incoming())
        && incoming().alertId == existing().alertId
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && !(existing().status in ['resolved', 'cancelled'])
        && (
          isAdmin() ||
          (existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'latitude', 'longitude', 'shareLiveLocation', 'note', 'updatedAt']))
        );
      allow delete: if isAdmin();
    }

    // 17. disaster_alerts (Official alerts: readable by signed-in users, writable ONLY by admin)
    match /disaster_alerts/{alertId} {
      allow get: if isSignedIn() && isValidId(alertId);
      allow list: if isSignedIn() && resource.data.verifiedOfficial == true;
      allow create, update: if isAdmin() && isValidId(alertId) && isValidDisasterAlert(incoming());
      allow delete: if isAdmin() && isValidId(alertId);
    }

    // 18. notifications
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && isValidId(notificationId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() && isValidId(notificationId)
        && isValidNotification(incoming())
        && incoming().userId == request.auth.uid
        && incoming().read == false
        && incoming().createdAt == request.time;
      allow update: if isVerifiedUser() && isValidId(notificationId)
        && isValidNotification(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && (
          isAdmin() ||
          (existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['read']))
        );
      allow delete: if isSignedIn() && isValidId(notificationId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // 19. security_logs
    match /security_logs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() && isValidId(logId)
        && isValidSecurityLog(incoming())
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // 20. admin_users (Strictly isolated to owner-level admins; no incoming() on delete)
    match /admin_users/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (isOwner(adminUid) || isAdmin());
      allow list: if isAdmin();
      allow create: if isOwnerAdmin() && isValidId(adminUid)
        && isValidAdminUser(incoming())
        && incoming().uid == adminUid
        && incoming().createdAt == request.time;
      allow update: if isOwnerAdmin() && isValidId(adminUid)
        && isValidAdminUser(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt;
      allow delete: if isOwnerAdmin() && isValidId(adminUid);
    }

    // 21. scheduled_posts (Scheduled chat wishes & status posts)
    match /scheduled_posts/{postId} {
      allow get: if isSignedIn() && isValidId(postId) && (existing().senderId == request.auth.uid || existing().receiverId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() && isValidId(postId)
        && isValidScheduledPost(incoming())
        && (!isSystemLockedDown() || isAdmin())
        && incoming().senderId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().wishTime > request.time
        && incoming().createdAt == request.time;
      allow update: if isVerifiedUser() && isValidId(postId)
        && isValidScheduledPost(incoming())
        && (!isSystemLockedDown() || isAdmin())
        && incoming().senderId == existing().senderId
        && incoming().createdAt == existing().createdAt
        && (incoming().status == 'cancelled' || incoming().wishTime > request.time)
        && !(existing().status in ['sent', 'cancelled'])
        && (
          isAdmin() ||
          (existing().senderId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'message', 'emojiKey', 'wishTime']))
        );
      allow delete: if isSignedIn() && isValidId(postId) && (existing().senderId == request.auth.uid || isAdmin());
    }

    // 22. phone_directory (Zero-trust SHA-256 phone lookup & duplicate-phone prevention, non-listable, owner-updatable/cancellable)
    match /phone_directory/{phoneHash} {
      allow get: if isSignedIn() && isValidId(phoneHash) && (
        resource == null ||
        existing().userId == request.auth.uid ||
        existing().discoverable == true ||
        isAdmin()
      );
      allow list: if isAdmin();
      allow create: if isVerifiedUser() && isValidId(phoneHash)
        && isValidPhoneDirectoryEntry(incoming())
        && (!isSystemLockedDown() || isAdmin())
        && incoming().phoneHash == phoneHash
        && incoming().userId == request.auth.uid
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(phoneHash)
        && isValidPhoneDirectoryEntry(incoming())
        && (!isSystemLockedDown() || isAdmin())
        && incoming().phoneHash == existing().phoneHash
        && incoming().userId == existing().userId
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'country', 'preferredLanguage', 'preferredLanguageName', 'discoverable', 'updatedAt']))
        );
      allow delete: if isSignedIn() && isValidId(phoneHash)
        && (!isSystemLockedDown() || isAdmin())
