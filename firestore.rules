    }

    // 23. contact_requests (Mutual consent connections with accept/decline/cancel controls)
    match /contact_requests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && (existing().senderId == request.auth.uid || existing().receiverId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() && isValidId(requestId)
        && isValidContactRequest(incoming())
        && (!isSystemLockedDown() || isAdmin())
        && incoming().requestId == requestId
        && incoming().senderId == request.auth.uid
        && isNotBlockedInProfileMedia(incoming().receiverId)
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(requestId)
        && isValidContactRequest(incoming())
        && incoming().requestId == existing().requestId
        && incoming().senderId == existing().senderId
        && incoming().receiverId == existing().receiverId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (!isSystemLockedDown() || isAdmin())
        && !(existing().status in ['accepted', 'cancelled', 'declined'])
        && (
          isAdmin() ||
          (existing().senderId == request.auth.uid && incoming().status == 'cancelled' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
          (existing().receiverId == request.auth.uid && incoming().status in ['accepted', 'declined'] && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
        );
      allow delete: if isSignedIn() && isValidId(requestId) && (existing().senderId == request.auth.uid || existing().receiverId == request.auth.uid || isAdmin());
    }

    // 24. system_security (Server/admin-controlled global security status: NORMAL | LOCKDOWN | RECOVERING)
    match /system_security/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(docId) && isValidGlobalSecurityState(incoming()) && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(docId);
    }

    // 25. security_incidents (Verified server/admin threat incidents)
    match /security_incidents/{incidentId} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(incidentId) && isValidSecurityIncident(incoming());
      allow delete: if isAdmin() && isValidId(incidentId);
    }

    // 26. security_audit_logs (Immutable append-only audit trail)
    match /security_audit_logs/{auditId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() && isValidId(auditId) && isValidSecurityAuditLog(incoming()) && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if false;
    }

    // 27. gmail_approvals (Owner-only Gmail approval decisions & thread tracking)
    match /gmail_approvals/{approvalId} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(approvalId) && isValidGmailApproval(incoming());
      allow delete: if isAdmin() && isValidId(approvalId);
    }

    // 28. profile_media (Privacy-enforced personal profile images, bio, status & block list)
    match /profile_media/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (
        isOwner(userId) ||
        isAdmin() ||
        (
          !(request.auth.uid in existing().blockedUserIds) &&
          existing().profileVisibility != 'nobody' &&
          (
            existing().profilePhotoVisibility == 'everyone' ||
            existing().aboutVisibility == 'everyone' ||
            (
              (existing().profilePhotoVisibility == 'contacts' || existing().aboutVisibility == 'contacts') &&
              exists(/databases/$(database)/documents/contacts/$('cnt_' + userId + '_' + request.auth.uid)) &&
              get(/databases/$(database)/documents/contacts/$('cnt_' + userId + '_' + request.auth.uid)).data.blocked == false
            )
          )
        )
      );
      allow list: if isAdmin();
      allow create: if isVerifiedUser() && isValidId(userId) && isOwner(userId)
        && isValidProfileMedia(incoming())
        && (!isSystemLockedDown() || isAdmin())
        && incoming().userId == userId
        && incoming().userId == request.auth.uid
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(userId) && isOwner(userId)
        && isValidProfileMedia(incoming())
        && (!isSystemLockedDown() || isAdmin())
        && incoming().userId == existing().userId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['avatarDataUrl', 'coverDataUrl', 'avatarMimeType', 'coverMimeType', 'about', 'bio', 'statusMessage', 'profileVisibility', 'profilePhotoVisibility', 'aboutVisibility', 'blockedUserIds', 'syncVersion', 'updatedAt']);
      allow delete: if isVerifiedUser() && isValidId(userId) && (isOwner(userId) || isAdmin()) && !isSystemLockedDown();
    }

    // 29. calls (Lightweight 1-to-1 mobile/web call invite & status transitions with 45s TTL)
    match /calls/{callId} {
      allow get: if isSignedIn() && isValidId(callId) && (
        existing().callerId == request.auth.uid ||
        existing().receiverId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.callerId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isVerifiedUser() && isValidId(callId)
        && isValidCallSignal(incoming())
        && (!isSystemLockedDown() || isAdmin())
        && (!('callId' in incoming()) || incoming().callId == callId)
        && incoming().callerId == request.auth.uid
        && incoming().receiverId != request.auth.uid
        && (
          !exists(/databases/$(database)/documents/profile_media/$(incoming().receiverId)) ||
          !(request.auth.uid in get(/databases/$(database)/documents/profile_media/$(incoming().receiverId)).data.blockedUserIds)
        )
        && incoming().status == 'ringing'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (!('endedAt' in incoming()) || incoming().endedAt == null);
      allow update: if isVerifiedUser() && isValidId(callId)
        && isValidCallSignal(incoming())
        && (!isSystemLockedDown() || isAdmin())
        && (!('callId' in existing()) || incoming().callId == existing().callId)
        && incoming().callerId == existing().callerId
        && incoming().receiverId == existing().receiverId
        && (!('callerName' in existing()) || incoming().callerName == existing().callerName)
        && (!('receiverName' in existing()) || incoming().receiverName == existing().receiverName)
        && incoming().callType == existing().callType
        && incoming().createdAt == existing().createdAt
        && incoming().expiresAt == existing().expiresAt
        && incoming().updatedAt == request.time
        && !(existing().status in ['rejected', 'ended'])
        && (
          isAdmin() ||
          (
            existing().receiverId == request.auth.uid &&
            existing().status == 'ringing' &&
            incoming().status in ['accepted', 'rejected'] &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          ) ||
          (
            (existing().callerId == request.auth.uid || existing().receiverId == request.auth.uid) &&
            incoming().status == 'ended' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'endedAt', 'updatedAt']) &&
            (!('endedAt' in incoming()) || incoming().endedAt == request.time)
          )
        );
      allow delete: if isAdmin() && !isSystemLockedDown();
    }

    // 30. statuses (WhatsApp-style 24-hour expiring Status updates with privacy ACL, viewers & reactions)
    match /statuses/{statusId} {
      allow get: if isSignedIn() && isValidId(statusId) && (
        existing().userId == request.auth.uid ||
        isAdmin() ||
        (
          request.auth.uid in existing().authorizedViewerIds &&
          !(request.auth.uid in existing().excludedViewerIds) &&
          existing().expiresAt > request.time &&
          isNotBlockedInProfileMedia(existing().userId)
        )
      );
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        request.auth.uid in resource.data.authorizedViewerIds ||
        isAdmin()
      );
      allow create: if isVerifiedUser() && isValidId(statusId)
        && isValidStatusUpdate(incoming())
        && (!isSystemLockedDown() || isAdmin())
        && incoming().statusId == statusId
        && incoming().userId == request.auth.uid
        && request.auth.uid in incoming().authorizedViewerIds
        && incoming().viewedByUids.size() == 0
        && incoming().viewers.size() == 0
        && incoming().reactions.size() == 0
        && incoming().createdAt == request.time;
      allow update: if isVerifiedUser() && isValidId(statusId)
        && isValidStatusUpdate(incoming())
        && (!isSystemLockedDown() || isAdmin())
        && incoming().statusId == existing().statusId
        && incoming().userId == existing().userId
        && incoming().mediaType == existing().mediaType
        && incoming().createdAt == existing().createdAt
        && incoming().expiresAt == existing().expiresAt
        && (!('textContent' in existing()) || incoming().textContent == existing().textContent)
        && (!('mediaUrl' in existing()) || incoming().mediaUrl == existing().mediaUrl)
        && (!('caption' in existing()) || incoming().caption == existing().caption)
        && (
          isAdmin() ||
          (
            existing().userId == request.auth.uid &&
            request.auth.uid in incoming().authorizedViewerIds &&
            incoming().diff(existing()).affectedKeys().hasOnly(['privacyMode', 'authorizedViewerIds', 'excludedViewerIds', 'allowedViewerIds'])
          ) ||
          (
            request.auth.uid in existing().authorizedViewerIds &&
            !(request.auth.uid in existing().excludedViewerIds) &&
            existing().expiresAt > request.time &&
            isNotBlockedInProfileMedia(existing().userId) &&
            incoming().viewedByUids.hasAll(existing().viewedByUids) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['viewedByUids', 'viewers', 'reactions'])
          )
        );
      allow delete: if isSignedIn() && isValidId(statusId)
        && (!isSystemLockedDown() || isAdmin())
        && (existing().userId == request.auth.uid || isAdmin());
    }

    // 31. location_consents (Private owner-only consented location preferences; never public)
    match /location_consents/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedUser() && isValidId(userId) && isOwner(userId)
        && isValidLocationConsent(incoming())
        && incoming().userId == request.auth.uid
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(userId)
        && isValidLocationConsent(incoming())
        && incoming().userId == existing().userId
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['gpsConsentGranted', 'autoTravelUpdateEnabled', 'sharingActive', 'locationSource', 'country', 'countryCode', 'province', 'district', 'city', 'latitude', 'longitude', 'accuracyMeters', 'updatedAt']))
        );
      allow delete: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    // 32. emergency_reports (Owner + explicitly authorized recipients only; never public or AI-verified)
    match /emergency_reports/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId) && (
        existing().userId == request.auth.uid ||
        request.auth.uid in existing().authorizedRecipientIds ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        request.auth.uid in resource.data.authorizedRecipientIds ||
        isAdmin()
      );
      allow create: if isVerifiedUser() && isValidId(reportId)
        && isValidEmergencyReport(incoming())
        && (!isSystemLockedDown() || isAdmin())
        && incoming().reportId == reportId
        && incoming().userId == request.auth.uid
        && incoming().aiVerified == false
        && incoming().verifiedOfficial == false
        && incoming().emergencyServicesNotified == false
        && incoming().status == 'active'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(reportId)
        && isValidEmergencyReport(incoming())
        && (!isSystemLockedDown() || isAdmin())
        && incoming().reportId == existing().reportId
        && incoming().userId == existing().userId
        && incoming().aiVerified == false
        && incoming().verifiedOfficial == false
        && incoming().emergencyServicesNotified == false
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().userId == request.auth.uid &&
            !(existing().status in ['resolved', 'cancelled']) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'description', 'consentedLocation', 'authorizedRecipientIds', 'sharedWithContacts', 'notifiedRecipientsCount', 'failedRecipientsCount', 'updatedAt'])
          )
        );
      allow delete: if isSignedIn() && isValidId(reportId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // 33. language_catalog (Dynamic world languages registry; publicly readable, admin writable)
    match /language_catalog/{langCode} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin() && isValidId(langCode) && (request.method == 'delete' || isValidLanguageCatalogItem(incoming()));
    }

    // 34. qr_tokens (Capability-based PK Chat QR tokens; owner & verified scanner lookup, zero PII)
    match /qr_tokens/{tokenId} {
      allow get: if isSignedIn() && isValidId(tokenId) && (
        existing().userId == request.auth.uid ||
        isAdmin() ||
        (
          existing().status == 'active' &&
          existing().expiresAt > request.time &&
          isNotBlockedInProfileMedia(existing().userId)
        )
      );
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isVerifiedUser() && isValidId(tokenId)
        && isValidQrToken(incoming())
        && (!isSystemLockedDown() || isAdmin())
        && incoming().tokenId == tokenId
        && incoming().userId == request.auth.uid
        && incoming().status == 'active'
        && incoming().issuedAt == request.time
        && incoming().updatedAt == request.time
        && incoming().expiresAt > request.time;
      allow update: if isVerifiedUser() && isValidId(tokenId)
        && isValidQrToken(incoming())
        && (!isSystemLockedDown() || isAdmin())
        && incoming().tokenId == existing().tokenId
        && incoming().userId == existing().userId
        && incoming().issuedAt == existing().issuedAt
        && incoming().expiresAt == existing().expiresAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().userId == request.auth.uid &&
            existing().status == 'active' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'country', 'countryCode', 'preferredLanguage', 'preferredLanguageName', 'about', 'status', 'updatedAt'])
          )
        );
      allow delete: if isSignedIn() && isValidId(tokenId) && (existing().userId == request.auth.uid || isAdmin()) && !isSystemLockedDown();
    }

    // 35. business_profiles (Public-safe business ad cards without personal phone or email PII)
    match /business_profiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (
        isOwner(userId) ||
        isAdmin() ||
        existing().selfieVerified == true
      );
      allow list: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        isAdmin() ||
        (resource.data.selfieVerified == true && request.query.limit != null && request.query.limit <= 50)
      );
      allow create: if isVerifiedUser() && isValidId(userId) && isOwner(userId)
        && isValidBusinessProfile(incoming())
        && (!isSystemLockedDown() || isAdmin())
        && incoming().ownerUid == request.auth.uid
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(userId)
        && isValidBusinessProfile(incoming())
        && (!isSystemLockedDown() || isAdmin())
        && incoming().businessId == existing().businessId
        && incoming().ownerUid == existing().ownerUid
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['businessName', 'category', 'tagline', 'city', 'country', 'countryCode', 'primaryLanguage', 'enableDirectCall', 'enableLiveClass', 'selfieVerified', 'selfieVerificationHash', 'updatedAt']))
        );
      allow delete: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    // 36. sponsored_ads (Country/Language targeted ads strictly separate from Contacts Status; zero auto-ban on false reports)
    match /sponsored_ads/{adId} {
      allow get: if isSignedIn() && isValidId(adId) && (
        existing().sellerUid == request.auth.uid ||
        isAdmin() ||
        existing().status in ['active', 'under_review']
      );
      allow list: if isSignedIn() && (
        resource.data.sellerUid == request.auth.uid ||
        isAdmin() ||
        (resource.data.status in ['active', 'under_review'] && request.query.limit != null && request.query.limit <= 30)
      );
      allow create: if isVerifiedUser() && isValidId(adId)
        && isValidSponsoredAd(incoming())
        && (!isSystemLockedDown() || isAdmin())
        && incoming().adId == adId
        && incoming().sellerUid == request.auth.uid
        && incoming().status == 'active'
        && incoming().reportCount == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(adId)
        && isValidSponsoredAd(incoming())
        && (!isSystemLockedDown() || isAdmin())
        && incoming().adId == existing().adId
        && incoming().sellerUid == existing().sellerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().sellerUid == request.auth.uid &&
            incoming().status == existing().status &&
            incoming().reportCount == existing().reportCount &&
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'targetCountry', 'targetLanguage', 'enableDirectCall', 'enableLiveClass', 'updatedAt'])
          )
        );
      allow delete: if isSignedIn() && isValidId(adId) && (existing().sellerUid == request.auth.uid || isAdmin());
    }

    // 37. ad_fulfillment_requests (Isolated 1-to-1 buyer-seller delivery/pickup & $0 Product Received)
    match /ad_fulfillment_requests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && (
        existing().buyerUid == request.auth.uid ||
        existing().sellerUid == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.buyerUid == request.auth.uid ||
        resource.data.sellerUid == request.auth.uid ||
        isAdmin()
      );
      allow create: if isVerifiedUser() && isValidId(requestId)
        && isValidAdFulfillmentRequest(incoming())
        && (!isSystemLockedDown() || isAdmin())
        && incoming().requestId == requestId
        && incoming().buyerUid == request.auth.uid
        && incoming().status == 'requested'
        && incoming().feeUsd == 0
        && incoming().createdAt == request.time;
      allow update: if isVerifiedUser() && isValidId(requestId)
        && isValidAdFulfillmentRequest(incoming())
        && (!isSystemLockedDown() || isAdmin())
        && incoming().requestId == existing().requestId
        && incoming().adId == existing().adId
        && incoming().sellerUid == existing().sellerUid
        && incoming().buyerUid == existing().buyerUid
        && incoming().createdAt == existing().createdAt
        && (
          isAdmin() ||
          (
            existing().sellerUid == request.auth.uid &&
            incoming().status == 'confirmed' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status'])
          ) ||
          (
            existing().buyerUid == request.auth.uid &&
            incoming().status == 'received' &&
            incoming().feeUsd == 0 &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status'])
          )
        );
      allow delete: if isAdmin();
    }

    // 38. ad_reports (Categorized UGC reports; immutable audit trail readable by reporter or admin)
    match /ad_reports/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId) && (existing().reporterUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.reporterUid == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() && isValidId(reportId)
        && isValidAdReport(incoming())
        && incoming().reportId == reportId
        && incoming().reporterUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update, delete: if isAdmin();
    }

    // 39. violation_warnings (Verified admin-only violation warnings; readable by recipient seller or admin)
    match /violation_warnings/{warningId} {
      allow get: if isSignedIn() && isValidId(warningId) && (existing().sellerUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.sellerUid == request.auth.uid || isAdmin());
      allow create: if isAdmin() && isValidId(warningId) && isValidViolationWarning(incoming()) && incoming().issuedAt == request.time;
      allow update: if isSignedIn() && isValidId(warningId) && isValidViolationWarning(incoming()) && (
        isAdmin() ||
        (existing().sellerUid == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['read']))
      );
      allow delete: if isAdmin();
    }

    // 40. remote_ad_config (Admin-writable Play Billing SKU and tier config)
    match /remote_ad_config/{configId} {
      allow get: if isSignedIn() && isValidId(configId);
      allow list: if isSignedIn();
      allow create, update, delete: if isAdmin() && isValidId(configId) && (request.method == 'delete' || isValidRemoteAdConfig(incoming()));
    }
  }
}
