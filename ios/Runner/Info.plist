<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>PK Chat</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>PK Chat</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>PK Chat uses the camera for profile photos, QR scanning, and live video calls.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>PK Chat uses the microphone for audio/video calls and voice messages.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>PK Chat accesses your photo library so you can select and crop a profile photo or share images.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>PK Chat saves exported QR cards, whiteboard snapshots, and media to your photo library when requested.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>PK Chat uses your location when you share SOS alerts, check nearby disaster warnings, or navigate offline.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>PK Chat shares live GPS updates for up to 5 hours during an active emergency SOS session you start.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>PK Chat uses Face ID to lock and unlock your private messages and app vault.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>location</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
